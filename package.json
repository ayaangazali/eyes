{
  "name": "eyes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit --passWithNoTests",
    "test:contract": "vitest run --project contract --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:safety": "vitest run --project safety --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:demo": "playwright test e2e/demo.spec.ts --repeat-each=3 --workers=1",
    "swarm": "node scripts/swarm.ts",
    "build": "pnpm -r --if-present build",
    "db:up": "docker run -d --rm --name eyes-pg -e POSTGRES_PASSWORD=eyes -e POSTGRES_DB=eyes -p 54329:5432 postgres:17",
    "db:migrate": "node packages/db/src/migrate.ts",
    "intent:check": "node scripts/check-intent.ts",
    "intent:index": "node scripts/check-intent.ts --write-index",
    "verify:fast": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:contract && pnpm test:safety && pnpm intent:check",
    "safety:eval": "node evals/safety/run.ts",
    "smoke:live": "node scripts/smoke-live.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.3.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
