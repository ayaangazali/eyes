EYES_PUBLIC_API_URL=http://127.0.0.1:3000
# Optional staged MCP connector; REST, uploads, webhooks and existing API connectors stay on API.
EYES_PUBLIC_MCP_URL=
EYES_WORKER_WEB_URL=http://127.0.0.1:5173
EYES_LINK_SECRET=replace-with-32-random-chars
EYES_TEST_MODE=true
EYES_PROVIDERS=fake
EYES_FAKE_WEBHOOKS=
EYES_OPS_KEY=
# Dispatch: workers within this many meters whose last location is younger than MAX_AGE_H hours.
EYES_DISPATCH_RADIUS_M=3000
EYES_LOCATION_MAX_AGE_H=24
# true: when too few workers are fresh nearby, text up to 5 stale ones "Eyes ping <nonce>" and re-offer after 30 s.
EYES_LOCATION_PING=false
# Optional public TestFlight link for the iPhone app. Unset: worker texts link to /install for ad hoc installation.
EYES_TESTFLIGHT_URL=
# Per worker: at most one location fix per MIN_INTERVAL_S seconds and DAILY_MAX per rolling day
# (1500 lets a shift Shortcut send one a minute all day).
EYES_LOCATION_MIN_INTERVAL_S=30
EYES_LOCATION_DAILY_MAX=1500
# Per agent per hour: task creates and quotes. Per worker per hour: photo uploads. Per agent: open unanswered tasks.
EYES_AGENT_TASKS_PER_HOUR=30
EYES_AGENT_QUOTES_PER_HOUR=120
EYES_WORKER_UPLOADS_PER_HOUR=20
EYES_MAX_OPEN_TASKS=20
DATABASE_URL=postgres://postgres:eyes@127.0.0.1:54329/eyes
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=eyes
INSFORGE_BASE_URL=
INSFORGE_ANON_KEY=
INSFORGE_API_KEY=
CRON_TOKEN=
# Shared with the eyes-api Worker (`wrangler secret put EDGE_SECRET`). Set: only requests carrying it may
# name the client IP (x-eyes-client-ip) and original host; direct hits lose cf-connecting-ip/x-forwarded-host.
EDGE_SECRET=
# Worker-only var, not read here: ORIGIN (e.g. https://<slug>.run.mcp-use.com) makes eyes-api forward every
# request there and stops it starting the Cloudflare container.
INKBOX_API_KEY=
INKBOX_AGENT_HANDLE=eyes-dispatch
INKBOX_PHONE_NUMBER=
INKBOX_WEBHOOK_SIGNING_KEY=
PRIMITIVE_API_KEY=
PRIMITIVE_WEBHOOK_SECRET=
PRIMITIVE_DOMAIN=
# 1 once Primitive grants the org send_to_any_domain (docs/DEPLOY.md section 4); unset, /status says email is replies only
PRIMITIVE_SEND_ANY_DOMAIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
MCP_USE_API_KEY=
ANALYTICS_INGEST_API_KEY=
EYES_DOCS_DIR=
BL_WORKSPACE=
BL_API_KEY=
EYES_OAUTH_SECRET=
