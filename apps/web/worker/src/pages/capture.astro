---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Eyes task"
  ogTitle="Eyes task: take one photo, get paid"
  description="Open this at the place you said YES to. Take one live photo and Eyes pays you once it checks out."
>
  <section id="task">
    <ul class="ui-meta">
      <li><span id="bounty" class="ui-badge ui-badge--accent"></span></li>
      <li class="task-deadline"><Icon name="clock" /><span id="deadline" class="ui-num"></span></li>
    </ul>
    <h1 id="question" class="ui-h1">Loading your task</h1>
    <p class="ui-place"><Icon name="pin" /><span id="place" class="ui-place__name"></span></p>
  </section>

  <p id="closed" class="ui-notice" role="status" hidden></p>
  <p id="error" class="ui-notice ui-notice--danger" role="alert" hidden></p>
  <button type="button" id="relocate" class="ui-button ui-button--block" hidden>Try location again</button>

  <form id="capture" class="ui-capture" hidden>
    <p class="ui-notice ui-notice--warning">
      <Icon name="no-face" />
      <span>
        <strong>Do not photograph faces.</strong> Point the camera at the place, the line or the shelf. Photos with
        faces are rejected.
      </span>
    </p>

    <figure class="ui-viewfinder">
      <div class="ui-viewfinder__empty"><Icon name="camera" class="size-8" /><span>Camera starting</span></div>
      <video id="video" autoplay muted playsinline></video>
      <img id="preview" alt="What you captured" hidden />
    </figure>

    <div id="live" hidden>
      <button type="button" id="shutter" class="ui-button ui-button--primary ui-button--block" disabled>
        Take photo
      </button>
    </div>
    <div id="fallback" class="grid gap-3" hidden>
      <p id="why" class="ui-field__hint">
        Your browser cannot show a live camera. A live photo is still required: take it now with your camera, not
        from your gallery.
      </p>
      <label class="ui-button ui-button--primary ui-button--block">
        Take the photo <input type="file" id="file" class="sr-only" accept="image/*" capture="environment" />
      </label>
    </div>

    <p class="ui-place ui-text-sm ui-text-secondary"><Icon name="locate" /><span id="gps" class="ui-num"></span></p>

    <fieldset id="yesno" class="ui-form__choices" hidden>
      <legend>Your answer</legend>
      <label class="ui-choice"><input type="radio" name="answer_bool" value="true" /> Yes</label>
      <label class="ui-choice"><input type="radio" name="answer_bool" value="false" /> No</label>
    </fieldset>

    <label class="ui-field">
      <span class="ui-field__label">Anything to add? (optional)</span>
      <input class="ui-input" name="answer_text" maxlength="1000" placeholder="e.g. about 6 people in line" />
    </label>

    <div class="ui-capture__dock">
      <button type="submit" id="send" class="ui-button ui-button--primary ui-button--block" disabled aria-describedby="todo">
        Send to Eyes
      </button>
      <p id="todo" class="ui-field__hint"></p>
    </div>
    <p class="ui-field__hint">Can't make it? Reply NO to the Eyes text to give the task back, so someone nearby can take it.</p>
  </form>

  <section id="result" class="ui-card" hidden>
    <h2 id="outcome" class="ui-card__answer">Sent</h2>
    <p id="message" class="m-0"></p>
    <ul id="checks" class="ui-checks"></ul>
    <p id="reason" class="ui-field__hint"></p>
    <p class="ui-field__hint">You can close this page.</p>
  </section>

  <p class="ui-field__hint">Questions? Reply HELP to the Eyes text.</p>
</Layout>
<style>
  .task-deadline:has(> #deadline[hidden]) {
    display: none;
  }
</style>

<script>
  import "../capture.ts";
</script>
