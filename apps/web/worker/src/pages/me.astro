---
import { ADS, smsHref } from "../api.ts";
import AgentLinks from "../components/AgentLinks.astro";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import { FILTERS } from "../me.ts";

const helpSms = smsHref("HELP");
const helpText = !helpSms ? " Text HELP to the Eyes number for a new link." : "";
---

<Layout
  title="Your Eyes setup"
  ogTitle="Eyes: your setup"
  description="See what is set up so Eyes can text you paid tasks near you."
  noindex
>
  <h1 id="title" class="ui-h1" tabindex="-1">Your Eyes setup</h1>

  <section id="loading" aria-busy="true">
    <p class="sr-only" role="status">Loading your setup</p>
    <div class="ui-card" aria-hidden="true">
      <ul class="ui-checks me-checks">
        {[0, 1, 2, 3].map(() => (
          <li class="ui-check me-row">
            <span class="ui-check__mark me-skeleton" />
            <span class="me-row__text">
              <span class="me-skeleton me-skeleton--title" />
              <span class="me-skeleton me-skeleton--detail" />
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="loaded" hidden>
    <div class="ui-card">
      <ul id="checks" class="ui-checks me-checks"></ul>
    </div>
    {ADS && (
      <aside id="ad" class="ui-card me-ad" aria-labelledby="ad-label">
        <span id="ad-label" class="ui-badge">Sponsored</span>
        <p class="ui-text-secondary ui-text-sm m-0">
          Ad space. Ad money here lowers what each human check costs. No sponsor is live yet.
        </p>
      </aside>
    )}
    <p id="install-error" class="ui-notice ui-notice--danger" role="alert" hidden></p>
    <div class="ui-card me-list">
      <div class="ui-card__header">
        <h2 class="ui-card__title">Your tasks</h2>
      </div>
      <dl id="totals" class="me-totals" hidden>
        <div><dt>Paid</dt><dd id="paid" class="ui-num"></dd></div>
        <div><dt>Pending</dt><dd id="pending" class="ui-num"></dd></div>
      </dl>
      <form id="controls" class="me-controls" role="search" hidden>
        <label class="sr-only" for="q">Search your tasks</label>
        <span class="me-search">
          <Icon name="search" />
          <input id="q" class="ui-input" type="search" placeholder="Question, place, date or amount" autocomplete="off" enterkeyhint="search" maxlength="100" />
        </span>
        <fieldset class="me-chips">
          <legend class="sr-only">Show</legend>
          {FILTERS.map((f) => (
            <label class="ui-choice me-chip"><input type="radio" name="filter" value={f.id} checked={f.id === "all"} />{f.label}</label>
          ))}
        </fieldset>
      </form>
      <ul id="tasks" class="me-tasks"></ul>
      <p id="tasks-note" class="ui-text-secondary ui-text-sm m-0" role="status"></p>
      <p id="tasks-error" class="ui-notice ui-notice--danger" role="alert" hidden></p>
      <button type="button" id="more" class="ui-button ui-button--block" hidden>Load more</button>
    </div>
    <AgentLinks />
  </section>

  <section id="missing" hidden>
    <p class="ui-notice"><Icon name="message" /> This link has no code.{helpText}</p>
    {helpSms && <a class="ui-button ui-button--primary ui-button--block" href={helpSms}>Text HELP for a new link</a>}
  </section>

  <section id="expired" hidden>
    <p class="ui-notice"><Icon name="clock" /> This link has expired.{helpText}</p>
    {helpSms && <a class="ui-button ui-button--primary ui-button--block" href={helpSms}>Text HELP for a new link</a>}
  </section>

  <section id="error" hidden>
    <p id="error-text" class="ui-notice ui-notice--danger" role="alert"></p>
    <button type="button" id="retry" class="ui-button ui-button--primary ui-button--block">Try again</button>
  </section>

  <template id="row">
    <li class="ui-check me-row">
      <span class="ui-check__mark"><Icon name="check" /></span>
      <span class="me-row__text">
        <span class="sr-only"></span>
        <strong></strong>
        <span class="ui-check__detail"></span>
      </span>
    </li>
  </template>

  <!-- Email remains optional: workers can acknowledge iMessage-only setup or remove a saved address. -->
  <template id="email-row">
    <li class="ui-check me-row me-email">
      <span class="ui-check__mark"><Icon name="mail" /></span>
      <span class="me-row__text">
        <strong></strong>
        <span class="ui-check__detail"></span>
        <span class="ui-text-sm ui-text-secondary me-email__help">Send from an address your mail provider verifies; custom aliases need SPF/DKIM.</span>
      </span>
      <div class="me-email__actions" data-mode="idle">
        <button type="button" class="ui-button" data-act="skip">Use iMessage only</button>
        <button type="button" class="ui-button ui-button--ghost" data-act="remove">Remove</button>
      </div>
      <div class="me-email__confirm" data-mode="confirm" role="group" aria-label="Remove email" hidden>
        <span class="ui-text-sm">Stop sending tasks to this email? Texts keep coming.</span>
        <div class="me-email__actions">
          <button type="button" class="ui-button ui-button--primary" data-act="confirm-remove">Remove email</button>
          <button type="button" class="ui-button ui-button--ghost" data-act="cancel">Keep it</button>
        </div>
      </div>
      <p class="ui-notice ui-notice--danger me-email__error" role="alert" hidden></p>
    </li>
  </template>

  <template id="task">
    <li class="me-task">
      <span class="me-task__question"></span>
      <span class="ui-num me-task__amount"></span>
      <span class="ui-text-secondary ui-text-sm me-task__meta"><span class="me-task__place"></span><span aria-hidden="true"> · </span><span class="me-task__date"></span></span>
      <span class="me-task__state"><span class="ui-badge me-task__status"></span><span class="ui-text-secondary ui-text-sm me-task__payout"></span></span>
      <span class="ui-text-sm me-task__hint" hidden>Reply HELP for a manual review.</span>
    </li>
  </template>
</Layout>

<style is:global>
  .ui-checks.me-checks {
    gap: var(--eyes-space-4);
  }

  /* Mark, then title and detail; the action sits under the text so a long label never squeezes it. */
  .ui-check.me-row {
    grid-template-columns: auto 1fr;
    align-items: start;
  }

  .me-row__text {
    display: grid;
    gap: 0.125rem;
  }

  .me-row > .ui-button,
  .me-email > :is(.me-email__actions, .me-email__confirm, .me-email__error) {
    grid-column: 2;
    justify-self: start;
  }

  .me-email > :is(.me-email__confirm, .me-email__error) {
    justify-self: stretch;
  }

  .me-email__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--eyes-space-2);
  }

  .me-email__confirm {
    display: grid;
    gap: var(--eyes-space-3);
  }


  /* Switching modes swaps the controls in place: the new ones fade and rise 4px from where the old ones were,
     ease-out under 200ms, so the row reads as one control changing rather than a block popping in. */
  .me-email > [data-mode] {
    transition:
      opacity var(--eyes-duration-enter) var(--eyes-ease-out),
      translate var(--eyes-duration-enter) var(--eyes-ease-out);

    @starting-style {
      opacity: 0;
      translate: 0 calc(var(--eyes-enter-y) * 0.66);
    }
  }


  /* ○ to do: an empty ring, so done (✓) and to do read apart at a glance. */
  .me-row--todo .ui-check__mark {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--eyes-border-strong);
  }

  /* Rows arrive 50ms apart when the data lands: one list filling in, not a block popping in. Opacity and
     translate only (reduced motion zeroes --eyes-enter-y, so it fades without moving). */
  .me-enter {
    transition:
      opacity var(--eyes-duration-enter) var(--eyes-ease-out) calc(var(--i, 0) * 50ms),
      translate var(--eyes-duration-enter) var(--eyes-ease-out) calc(var(--i, 0) * 50ms);
  }

  @starting-style {
    .me-enter {
      opacity: 0;
      translate: 0 var(--eyes-enter-y);
    }
  }

  .me-list {
    display: grid;
    gap: var(--eyes-space-4);
  }

  /* Sponsored slot (VITE_ADS): a plain card with a visible label, never mixed into the task list. */
  .me-ad {
    display: grid;
    justify-items: start;
    gap: var(--eyes-space-2);
  }

  /* Totals: two figures side by side, the money the worker came here for. */
  .me-totals {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--eyes-space-3);
    margin: 0;
  }

  .me-totals > div {
    padding: var(--eyes-space-3);
    border-radius: var(--eyes-radius-md);
    background: var(--eyes-surface-secondary);
  }

  .me-totals dt {
    color: var(--eyes-text-secondary);
    font-size: var(--eyes-text-sm);
  }

  .me-totals dd {
    margin: 0;
    font-size: var(--eyes-text-lg);
    font-weight: var(--eyes-weight-semibold);
  }

  .me-controls {
    display: grid;
    gap: var(--eyes-space-3);
  }

  .me-search {
    position: relative;
    display: block;
  }

  .me-search > .ui-icon {
    position: absolute;
    top: 50%;
    left: var(--eyes-space-3);
    translate: 0 -50%;
    color: var(--eyes-text-secondary);
    pointer-events: none;
  }

  .me-search > .ui-input {
    width: 100%;
    padding-left: calc(var(--eyes-space-3) * 2 + 1.25rem);
  }

  /* Chips scroll sideways on a phone instead of wrapping into a second row. */
  .me-chips {
    display: flex;
    gap: var(--eyes-space-2);
    margin: 0 calc(var(--eyes-space-1) * -1);
    padding: var(--eyes-space-1);
    border: 0;
    overflow-x: auto;
    scrollbar-width: none;
    /* A fieldset is min-content wide by default, which pushed the whole card past a phone's edge. */
    min-inline-size: 0;
  }

  .me-chip {
    position: relative;
    flex: none;
    min-height: 2.25rem;
    padding: 0 var(--eyes-space-3);
    font-size: var(--eyes-text-sm);
    transition: scale 120ms var(--eyes-ease-out);
  }

  .me-chip:active {
    scale: 0.97;
  }

  /* The radio stays for keyboard and screen readers; the chip itself shows the choice. */
  .me-chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .me-chip:has(:focus-visible) {
    outline: 2px solid var(--eyes-ring);
    outline-offset: 2px;
  }

  .me-chip:has(:checked) {
    border-color: var(--eyes-text);
    background: var(--eyes-text);
    color: var(--eyes-surface);
  }

  .me-tasks {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .me-tasks:empty {
    display: none;
  }

  /* A new search or filter dims the old rows until the answer lands: no motion, the worker is typing. */
  .me-tasks[aria-busy="true"] {
    opacity: 0.5;
  }

  .me-task {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.125rem var(--eyes-space-3);
    padding: var(--eyes-space-3) 0;
    border-top: 1px solid var(--eyes-border-subtle);
  }

  .me-task:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .me-task:last-child {
    padding-bottom: 0;
  }

  #tasks-note:empty {
    display: none;
  }

  .me-task__question {
    font-weight: var(--eyes-weight-medium);
    overflow-wrap: anywhere;
  }

  .me-task__amount {
    font-weight: var(--eyes-weight-semibold);
  }

  .me-task__meta,
  .me-task__state,
  .me-task__hint {
    grid-column: 1 / -1;
  }

  .me-task__state {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--eyes-space-2);
    margin-top: var(--eyes-space-1);
  }

  .me-task__hint {
    color: var(--eyes-text-secondary);
  }

  .me-task__payout:empty {
    display: none;
  }

  /* Loading: the page keeps its shape (four rows) and breathes, so it reads as "coming", not "broken". */
  .me-skeleton {
    display: block;
    border-radius: var(--eyes-radius-full);
    background: var(--eyes-surface-tertiary);
    animation: me-pulse 1.2s ease-in-out infinite alternate;
  }

  .me-skeleton--title {
    width: 9rem;
    height: 1rem;
  }

  .me-skeleton--detail {
    width: 13rem;
    max-width: 100%;
    height: 0.875rem;
    margin-top: 0.25rem;
  }

  @keyframes me-pulse {
    to {
      opacity: 0.45;
    }
  }

  /* Gentler, not none: the pulse slows down instead of stopping. */
  @media (prefers-reduced-motion: reduce) {
    .me-skeleton {
      animation-duration: 2.4s;
    }
  }
</style>

<script>
  import { $, call, Problem, showError } from "../api.ts";
  import { type EmailRow, removeEmail, skipEmail } from "../email.ts";
  import {
    FILTERS,
    type Filter,
    type MeView,
    meView,
    openInstall,
    type Row,
    showMe,
    type TaskLine,
    type TaskList,
    takeCode,
    taskList,
  } from "../me.ts";

  const ICONS: Record<Row["id"], string> = { texts: "message", spot: "locate", app: "expand", payouts: "cash" };

  // The code arrives in the URL fragment; takeCode clears it. It stays in memory only, for the install POST.
  const code = takeCode({
    hash: location.hash,
    pathname: location.pathname,
    search: location.search,
    replaceUrl: (url) => history.replaceState(null, "", url),
  });

  const part = (el: HTMLElement, selector: string) => el.querySelector(selector) as HTMLElement;

  function actionFor(row: Row, action: NonNullable<Row["action"]>): HTMLElement {
    const el = document.createElement(action.href ? "a" : "button");
    el.className = action.primary ? "ui-button ui-button--primary" : "ui-button";
    el.insertAdjacentHTML("afterbegin", `<svg class="ui-icon" aria-hidden="true"><use href="#i-${ICONS[row.id]}"></use></svg>`);
    el.append(action.label);
    if (el instanceof HTMLAnchorElement) el.href = action.href as string;
    else if (code) {
      const button = el as HTMLButtonElement;
      button.type = "button";
      button.addEventListener("click", () => {
        $("install-error").hidden = true;
        void openInstall(code, {
          send: call,
          busy: (on) => button.toggleAttribute("aria-busy", on),
          navigate: (url) => {
            location.href = url;
          },
          report: (err) => showError($("install-error"), err),
        });
      });
      // Back from the install page restores this page from the cache: drop the spinner it left with.
      addEventListener("pageshow", () => button.removeAttribute("aria-busy"));
    }
    return el;
  }

  function rowEl(row: Row, i: number): HTMLElement {
    const li = ($<HTMLTemplateElement>("row").content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
    li.classList.add(`me-row--${row.state}`, "me-enter");
    li.style.setProperty("--i", String(i));
    if (row.state === "todo") part(li, ".ui-check__mark").replaceChildren();
    if (row.state === "neutral") part(li, "use").setAttribute("href", "#i-info");
    if (row.state === "done") li.classList.add("ui-check--pass");
    part(li, ".sr-only").textContent = row.state === "todo" ? "To do: " : "Done: ";
    part(li, "strong").textContent = row.title;
    part(li, ".ui-check__detail").textContent = row.detail;
    if (row.action) li.append(actionFor(row, row.action));
    return li;
  }

  function emailEl(row: EmailRow, i: number): HTMLElement {
    const li = ($<HTMLTemplateElement>("email-row").content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
    const complete = row.status === "verified" || row.skipped;
    li.classList.add(complete ? "ui-check--pass" : "me-row--todo", "me-enter");
    li.style.setProperty("--i", String(i));
    if (!complete) part(li, ".ui-check__mark").replaceChildren();
    else if (row.skipped) part(li, "use").setAttribute("href", "#i-check");
    part(li, "strong").textContent = row.title;
    part(li, ".ui-check__detail").textContent = row.detail;
    part(li, ".me-email__help").hidden = row.skipped;
    const skip = part(li, "[data-act=skip]");
    skip.hidden = complete;
    part(li, "[data-act=remove]").hidden = !row.removable;
    part(li, ".me-email__actions[data-mode]").hidden = complete && !row.removable;
    const error = part(li, ".me-email__error");
    const mode = (m: "idle" | "confirm") => {
      for (const el of li.querySelectorAll<HTMLElement>(":scope > [data-mode]")) el.hidden = el.dataset.mode !== m;
      error.hidden = true;
      if (m === "confirm") part(li, "[data-act=confirm-remove]").focus();
    };
    const save = async (button: HTMLElement, action: typeof removeEmail) => {
      error.hidden = true;
      button.setAttribute("aria-busy", "true");
      for (const control of li.querySelectorAll<HTMLButtonElement>("button")) control.disabled = true;
      try {
        show(meView(await action(code as string, call), Date.now()));
        $("title").focus();
      } catch (err) {
        button.removeAttribute("aria-busy");
        for (const control of li.querySelectorAll<HTMLButtonElement>("button")) control.disabled = false;
        if (err instanceof Problem && err.status === 401) return show({ step: "expired" });
        showError(error, err);
      }
    };
    li.addEventListener("click", (e) => {
      const button = (e.target as Element).closest<HTMLElement>("button[data-act]");
      const act = button?.dataset.act;
      if (!button || button.hasAttribute("aria-busy")) return;
      if (act === "remove") mode("confirm");
      else if (act === "confirm-remove") void save(button, removeEmail);
      else if (act === "cancel") mode("idle");
      else if (act === "skip") void save(button, skipEmail);
    });
    return li;
  }

  // i: place in the arriving batch for the 50ms stagger; null for rows that replace a search or filter result,
  // which appear at once because the worker is typing or tapping and waits for exactly that answer.
  function taskEl(task: TaskLine, i: number | null): HTMLElement {
    const li = ($<HTMLTemplateElement>("task").content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
    if (i !== null) {
      li.classList.add("me-enter");
      li.style.setProperty("--i", String(Math.min(i, 8)));
    }
    part(li, ".me-task__question").textContent = task.question;
    part(li, ".me-task__amount").textContent = task.amount;
    part(li, ".me-task__place").textContent = task.place;
    part(li, ".me-task__date").textContent = task.date;
    const status = part(li, ".me-task__status");
    status.textContent = task.status;
    if (task.tone) status.classList.add(`ui-badge--${task.tone}`);
    part(li, ".me-task__payout").textContent = task.payout ?? "";
    part(li, ".me-task__hint").hidden = !task.review;
    return li;
  }

  let shown: string[] = [];
  let animate = true;

  function showList(list: TaskList) {
    const ul = $("tasks");
    ul.setAttribute("aria-busy", String(list.state === "loading"));
    if (list.state === "idle") {
      const ids = list.tasks.map((t) => t.id);
      const appended = shown.every((id, i) => ids[i] === id);
      const fresh = list.tasks.slice(appended ? shown.length : 0);
      const rows = fresh.map((t, i) => taskEl(t, animate ? i : null));
      if (appended) ul.append(...rows);
      else ul.replaceChildren(...rows);
      shown = ids;
    }
    $("totals").hidden = !list.any;
    $("controls").hidden = !list.any;
    $("paid").textContent = list.paid;
    $("pending").textContent = list.pending;
    const label = FILTERS.find((f) => f.id === list.filter)?.label;
    const q = list.q.trim();
    $("tasks-note").textContent =
      list.state === "loading" && !list.any
        ? "Loading your tasks…"
        : list.state !== "idle" || list.tasks.length > 0
          ? ""
          : !list.any
            ? "No tasks yet. Eyes texts you when one is near."
            : list.filter === "all"
              ? `No tasks match “${q}”.`
              : `Nothing in ${label}${q ? ` matches “${q}”` : ""}.`;
    const error = $("tasks-error");
    error.hidden = list.state !== "error";
    if (list.state === "error") showError(error, list.error);
    const more = $<HTMLButtonElement>("more");
    more.hidden = list.state !== "error" && !(list.cursor && list.state !== "loading");
    more.textContent = list.state === "error" ? "Try again" : "Load more";
    more.toggleAttribute("aria-busy", list.state === "more");
    // Re-observe so a page that still leaves the button on screen (a tall window) loads the next one too.
    if (list.state === "idle" && list.cursor) {
      autoMore.unobserve(more);
      autoMore.observe(more);
    }
  }

  let tasks: ReturnType<typeof taskList> | null = null;
  const autoMore = new IntersectionObserver(
    (entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        animate = true;
        void tasks?.more();
      }
    },
    { rootMargin: "0px 0px 400px 0px" },
  );

  function show(view: MeView) {
    for (const section of document.querySelectorAll<HTMLElement>("main > section")) {
      section.hidden = section.id !== view.step;
    }
    if (view.step === "error") showError($("error-text"), view.error);
    if (view.step !== "loaded") return;
    $("title").textContent = view.title;
    $("checks").replaceChildren(
      ...view.rows.map(rowEl),
      ...(view.email && code ? [emailEl(view.email, view.rows.length)] : []),
    );
    if (code && !tasks) {
      tasks = taskList(code, {
        send: call,
        show: showList,
        tz: Intl.DateTimeFormat().resolvedOptions().timeZone,
        live: view.live,
      });
      void tasks.load();
    }
  }

  let typing: ReturnType<typeof setTimeout> | undefined;
  const search = () => {
    clearTimeout(typing);
    animate = false;
    void tasks?.search($<HTMLInputElement>("q").value);
  };
  $("q").addEventListener("input", () => {
    clearTimeout(typing);
    typing = setTimeout(search, 250);
  });
  $("controls").addEventListener("submit", (e) => {
    e.preventDefault();
    search();
  });
  $("controls").addEventListener("change", (e) => {
    const input = e.target as HTMLInputElement;
    if (input.name !== "filter") return;
    animate = false;
    void tasks?.filter(input.value as Filter);
  });
  $("more").addEventListener("click", () => {
    animate = true;
    void ($("more").textContent === "Try again" ? tasks?.load() : tasks?.more());
  });

  const load = () => showMe(code, { send: call, now: Date.now, show });
  $("retry").addEventListener("click", load);
  void load();
</script>
