---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Install the Eyes app"
  ogTitle="Eyes: install the app"
  description="Install the Eyes app on your iPhone, so paid tasks near you find you."
  noindex
>
  <h1 class="ui-h1">Install the Eyes app</h1>
  <p class="ui-text-secondary">
    Three steps, about 10 minutes. Eyes comes straight from us, not the App Store, so iOS asks a few extra
    questions. Each step shows exactly what to tap.
  </p>

  <p id="checking" class="ui-notice" role="status"><Icon name="pending" /> Checking your iPhone…</p>

  <p id="not-iphone" class="ui-notice" hidden>
    <Icon name="info" /> Open this page on your iPhone in Safari: tap the link Eyes texted you.
  </p>

  <p id="missing" class="ui-notice" hidden><Icon name="message" /> Text APP to Eyes to get your install link.</p>

  <p id="expired" class="ui-notice ui-notice--danger" role="alert" hidden>
    <Icon name="alert" /> This link has expired. Text APP to Eyes for a new one.
  </p>

  <p id="error" class="ui-notice ui-notice--danger" role="alert" hidden></p>

  <p id="connected" class="ui-notice ui-notice--success" role="status" hidden>
    <Icon name="check" /> Eyes is connected. You can close this page.
  </p>

  <p id="done" class="ui-notice ui-notice--success" role="status" hidden>
    <Icon name="check" /> All steps done. You can close this page.
  </p>

  <ol id="steps" class="ui-steps install" hidden>
    <li data-key="register">
      <div class="step">
        <h2 class="ui-h3">Register this iPhone</h2>
        <div class="step__body">
          <a id="profile" class="ui-button ui-button--primary ui-button--block"><Icon name="shield" /> Register this iPhone</a>
          <ol class="screens">
            <li>
              Safari asks:
              <figure class="ios" aria-label="iOS dialog">
                <p>This website is trying to download a configuration profile. Do you want to allow this?</p>
                <span>Ignore</span><b>Allow</b>
              </figure>
              Tap <b>Allow</b>, then <b>Close</b>.
            </li>
            <li>Open the <b>Settings</b> app. Tap <b>Profile Downloaded</b>, near the top under your name.</li>
            <li>
              Tap <b>Install</b> (top right), enter your iPhone passcode, then tap <b>Install</b> again. iOS calls the
              profile "Unverified": that's expected. It only reads this iPhone's device ID and installs nothing.
            </li>
            <li>Safari opens this page again, at step 2.</li>
          </ol>
          <details class="help">
            <summary>Didn't work?</summary>
            <ul>
              <li>
                No <b>Profile Downloaded</b> in Settings? Open Settings › General › <b>VPN &amp; Device Management</b>
                and tap the Eyes profile.
              </li>
              <li>Tapped Ignore, or nothing happened? Tap <b>Register this iPhone</b> again.</li>
              <li>In Chrome or another app? Open this link in <b>Safari</b>: only Safari can register.</li>
            </ul>
          </details>
          <p class="ui-field__hint">
            Apple lets an app from outside the App Store run only on iPhones registered by device ID.{" "}
            <a class="ui-link" href="https://eyes.pictures/privacy">How Eyes uses it</a>
          </p>
          <button type="button" class="ui-link skip" data-skip="1">I already did this</button>
        </div>
      </div>
    </li>

    <li data-key="install">
      <div class="step">
        <h2 class="ui-h3">Install Eyes</h2>
        <div class="step__body">
          <p id="waiting" class="ui-notice ui-notice--success" role="status" hidden>
            <Icon name="check" /> This iPhone is registered. Apple needs to add it first: Eyes texts you when the app
            is ready, usually within 15 minutes. Tap that text to come back here.
          </p>
          <a id="itms" class="ui-button ui-button--primary ui-button--block" hidden><Icon name="expand" /> Install Eyes</a>
          <ol class="screens">
            <li>
              iOS asks:
              <figure class="ios" aria-label="iOS dialog">
                <p>“app.eyes.pictures” would like to install “Eyes”</p>
                <span>Cancel</span><b>Install</b>
              </figure>
              Tap <b>Install</b>. The Eyes icon appears on your Home Screen and fills in when it's done.
            </li>
          </ol>
          <details class="help">
            <summary>Didn't work?</summary>
            <ul>
              <li>"Unable to install Eyes"? Apple hasn't added this iPhone yet. Wait for the Eyes text, then try again.</li>
              <li>Nothing happens? Go to your Home Screen and look for the Eyes icon: it may still be loading.</li>
            </ul>
          </details>
          <button type="button" class="ui-link skip" data-skip="2">I already did this</button>
        </div>
      </div>
    </li>

    <li data-key="open">
      <div class="step">
        <h2 class="ui-h3">Open Eyes</h2>
        <div class="step__body">
          <button id="open" type="button" class="ui-button ui-button--primary ui-button--block" aria-describedby="open-status" disabled hidden>
            <span id="open-fill" aria-hidden="true"></span>
            <Icon name="locate" /><span id="open-label">Open Eyes</span>
          </button>
          <p id="open-status" class="ui-field__hint" role="status" aria-live="polite"></p>
          <p id="open-fallback" class="ui-field__hint">Tap the link in the Eyes text to open the app.</p>
          <ol class="screens">
            <li>
              iOS asks:
              <figure class="ios" aria-label="iOS dialog">
                <p>Allow “Eyes” to use your location?</p>
                <span>Don't Allow</span><b>Allow While Using App</b>
              </figure>
              Tap <b>Allow While Using App</b>. Eyes shows <b>Sharing</b>: you're set.
            </li>
            <li>
              iOS then asks to use your location when you're not using the app: tap <b>Change to Always Allow</b>, so
              Eyes keeps working while it's closed.
            </li>
          </ol>
          <details class="help">
            <summary>Didn't work?</summary>
            <ul>
              <li>Tapped Don't Allow? In Eyes, tap <b>Open Settings</b>, then Location › <b>Always</b>.</li>
            </ul>
          </details>
          <details class="help">
            <summary>If Eyes won't open</summary>
            <ul>
              <li>iOS says <b>Developer Mode Required</b>? Tap <b>OK</b>.</li>
              <li>
                Open <b>Settings</b> › <b>Privacy &amp; Security</b>. Scroll to the bottom, tap <b>Developer Mode</b>
                and switch it on. No Developer Mode there? Open Eyes once, then look again.
              </li>
              <li>
                Tap <b>Restart</b>. After the restart, unlock your iPhone, tap <b>Turn On</b> and enter your passcode.
                Then tap <b>Open Eyes</b> again.
              </li>
              <li>Already on? Nothing to do here.</li>
            </ul>
          </details>
          <button type="button" class="ui-link skip" data-skip="3">I already did this</button>
        </div>
      </div>
    </li>
  </ol>
</Layout>

<style>
  .install > li > .step {
    display: grid;
    gap: var(--eyes-space-3);
    padding: var(--eyes-space-4);
    border-radius: var(--eyes-radius-2xl);
    background: var(--eyes-surface);
    box-shadow: var(--eyes-hairline);
    transition: box-shadow var(--eyes-duration-enter) var(--eyes-ease-out);
  }
  .install > li::before {
    margin-top: var(--eyes-space-4);
  }
  .install h2 {
    margin: 0;
    line-height: 1.75rem;
  }
  /* Done steps fold to their title; the current one carries the accent ring. */
  .install > li[data-done] .step__body {
    display: none;
  }
  .install > li[data-done] h2 {
    color: var(--eyes-text-secondary);
  }
  .install > li[aria-current="step"] > .step {
    box-shadow: 0 0 0 2px var(--eyes-accent);
  }
  .install > li:not([data-done], [aria-current="step"]) .step__body {
    opacity: 0.6;
  }
  /* A button that reads as a link, with a full-height tap target. */
  .skip {
    justify-self: start;
    padding: calc((var(--eyes-tap) - 1em) / 2) 0;
    border: 0;
    background: none;
    color: var(--eyes-text-secondary);
    font: inherit;
    font-size: var(--eyes-text-sm);
    text-decoration: underline;
    cursor: pointer;
  }
  .step__body {
    display: grid;
    gap: var(--eyes-space-3);
  }
  #open {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  #open:disabled {
    opacity: 1;
    background: var(--eyes-surface-tertiary);
    color: var(--eyes-text);
  }
  #open[aria-busy="true"]::before {
    content: none;
  }
  #open-fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--eyes-accent);
    opacity: 0.3;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 100ms linear;
    pointer-events: none;
  }
  #open:not(:disabled) #open-fill {
    opacity: 0;
  }
  .screens {
    display: grid;
    gap: var(--eyes-space-3);
    margin: 0;
    padding-left: 1.25rem;
    list-style: decimal;
  }
  .screens > li::marker {
    color: var(--eyes-text-secondary);
  }
  /* A drawing of the iOS alert, with the button to tap filled. */
  .ios {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--eyes-space-2);
    max-width: 17rem;
    margin: var(--eyes-space-2) 0;
    padding: var(--eyes-space-3);
    border-radius: var(--eyes-radius-xl);
    background: var(--eyes-surface-secondary);
    font-size: var(--eyes-text-sm);
  }
  .ios p {
    grid-column: 1 / -1;
    margin: 0;
    font-weight: var(--eyes-weight-semibold);
    text-align: center;
  }
  .ios span,
  .ios b {
    padding: var(--eyes-space-2);
    border-radius: var(--eyes-radius-full);
    text-align: center;
  }
  .ios span {
    background: var(--eyes-surface-tertiary);
    color: var(--eyes-text-secondary);
  }
  .ios b {
    background: var(--eyes-accent);
    color: var(--eyes-on-accent);
  }
  .help summary {
    cursor: pointer;
    color: var(--eyes-text-secondary);
    font-size: var(--eyes-text-sm);
  }
  .help ul {
    display: grid;
    gap: var(--eyes-space-2);
    margin: var(--eyes-space-2) 0 0;
    padding-left: 1.25rem;
    font-size: var(--eyes-text-sm);
  }
  @media (prefers-reduced-motion: reduce) {
    .install > li > .step {
      transition: none;
    }
    #open-fill {
      transition: none;
    }
  }
</style>

<script>
  import { $, call, showError } from "../api.ts";
  import { checkInstall, type InstallDeps, type InstallStep, installOpenGate, loadSaved, markDone, OPEN_WAIT_MS, readCode, startInstall } from "../install.ts";

  const ORDER = ["register", "install", "open"];
  const NOTICES = ["not-iphone", "missing", "expired", "error", "connected", "done"];
  const openButton = $<HTMLButtonElement>("open");
  let openUrl = "";
  const gate = installOpenGate({
    code: readCode(location.hash) ?? loadSaved(localStorage, Date.now())?.code ?? null,
    store: localStorage,
    doc: document,
    win: window,
    render: (left, enabled) => {
      openButton.disabled = !enabled;
      openButton.setAttribute("aria-busy", String(!enabled));
      $("open-fill").style.transform = `scaleX(${1 - Math.min(left / OPEN_WAIT_MS, 1)})`;
      $("open-label").textContent = left > 0 ? `Open Eyes in ${Math.ceil(left / 1_000)}s` : "Open Eyes";
      $("open-status").textContent = left > 0
        ? "Waiting briefly for app registration. This is not installation progress."
        : enabled ? "Ready to open Eyes." : "Waiting for this iPhone to be ready.";
    },
  });

  function show(step: InstallStep) {
    $("checking").hidden = true;
    for (const id of NOTICES) $(id).hidden = id !== step;
    if (NOTICES.slice(0, 4).includes(step)) return;
    $("steps").hidden = false;
    $("waiting").hidden = step !== "waiting";
    const current = step === "connected" || step === "done" ? ORDER.length : ORDER.indexOf(step === "waiting" ? "install" : step);
    document.querySelectorAll<HTMLLIElement>("#steps > li").forEach((li, i) => {
      li.toggleAttribute("data-done", i < current);
      if (i === current) li.setAttribute("aria-current", "step");
      else li.removeAttribute("aria-current");
    });
  }

  const deps: InstallDeps = {
    hash: location.hash,
    pathname: location.pathname,
    search: location.search,
    userAgent: navigator.userAgent,
    replaceUrl: (url) => history.replaceState(null, "", url),
    send: call,
    show,
    setHref: (id, href) => {
      if (id === "open") {
        openUrl = href;
        openButton.hidden = false;
        $("open-fallback").hidden = true;
      } else {
        const a = $<HTMLAnchorElement>(id);
        a.href = href;
        a.hidden = false;
      }
    },
    setReady: (ready) => gate.setReady(ready),
    report: (err) => showError($("error"), err),
    store: localStorage,
    now: Date.now(),
    poll: {
      sleep: (ms) => new Promise((r) => setTimeout(r, ms)),
      visible: () => !document.hidden,
      clock: Date.now,
    },
  };
  // The code arrives in the URL fragment; startInstall clears it from the address bar.
  startInstall(deps);

  $("itms").addEventListener("click", () => {
    markDone(localStorage, Date.now(), 2);
    gate.begin();
    show("open");
  });
  openButton.addEventListener("click", () => gate.open(() => { location.href = openUrl; }));
  document.querySelectorAll<HTMLButtonElement>("[data-skip]").forEach((b) =>
    b.addEventListener("click", () => {
      markDone(localStorage, Date.now(), Number(b.dataset.skip));
      if (b.dataset.skip === "2") gate.begin();
      checkInstall({ ...deps, now: Date.now() });
    }),
  );
</script>
