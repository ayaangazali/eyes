---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";

const testflightUrl: string | undefined = import.meta.env.VITE_TESTFLIGHT_URL || undefined;
---

<Layout
  title="Open the Eyes app"
  ogTitle="Eyes: open the app"
  description="Connect the Eyes app so paid tasks near you find you."
  noindex
>
  <h1 class="ui-h1">Open the Eyes app</h1>
  <p class="ui-text-secondary">
    The app tells Eyes roughly where you are, so paid tasks near you find you. One tap connects it to your number.
  </p>

  <div id="ready" hidden>
    <a id="open" class="ui-button ui-button--primary ui-button--block" href="eyes://connect">
      <Icon name="expand" /> Open in the Eyes app
    </a>
    <p class="ui-field__hint" style="margin-top:.75rem">Don't have the app yet? {testflightUrl ? <a href={testflightUrl}>Install it with TestFlight</a> : "Ask the Eyes team for an invite (TestFlight coming)."}</p>
  </div>

  <p id="missing" class="ui-notice" hidden>
    <Icon name="message" /> This link has no code. Text APP to the Eyes number for a new link.
  </p>
</Layout>

<script>
  import { startApp } from "../app-link.ts";

  // The code arrives in the URL fragment; startApp clears it from the address bar.
  startApp({
    hash: location.hash,
    pathname: location.pathname,
    search: location.search,
    replaceUrl: (url) => history.replaceState(null, "", url),
    reveal: (id) => {
      (document.getElementById(id) as HTMLElement).hidden = false;
    },
    setHref: (id, href) => {
      (document.getElementById(id) as HTMLAnchorElement).href = href;
    },
    onLoad: (fn) => addEventListener("load", fn),
    later: (fn, ms) => {
      setTimeout(fn, ms);
    },
    navigate: (url) => {
      location.href = url;
    },
  });
</script>
