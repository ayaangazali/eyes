---
import { smsHref } from "../api.ts";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";

const appSms = smsHref("APP");
const hereSms = smsHref("HERE");
---

<Layout
  title="Open the Eyes app"
  ogTitle="Eyes: open the app"
  description="Connect the Eyes app so paid tasks near you find you."
  noindex
>
  <h1 class="ui-h1">Open the Eyes app</h1>
  <p class="ui-text-secondary">
    The app tells Eyes roughly where you are, so paid tasks near you find you. One tap connects it to your number.
  </p>

  <section id="ready" hidden>
    <a id="open" class="ui-button ui-button--primary ui-button--block" href="eyes://connect">
      <Icon name="expand" /> Install / open Eyes app
    </a>
  </section>

  <section id="review" hidden>
    <p class="ui-notice">
      <Icon name="message" /> The Eyes app is in Apple's review. Text HERE to share your spot meanwhile.
    </p>
    {hereSms && <a class="ui-button ui-button--primary ui-button--block" href={hereSms}>Text HERE to Eyes</a>}
  </section>

  <section id="missing" hidden>
    <p class="ui-notice">
      <Icon name="message" /> This link has no code.{!appSms && " Text APP to the Eyes number for a new link."}
    </p>
    {appSms && <a class="ui-button ui-button--primary ui-button--block" href={appSms}>Text APP for a new link</a>}
  </section>
</Layout>

<script>
  import { startApp } from "../app-link.ts";

  // The code arrives in the URL fragment; startApp clears it from the address bar.
  startApp({
    hash: location.hash,
    pathname: location.pathname,
    search: location.search,
    replaceUrl: (url) => history.replaceState(null, "", url),
    reveal: (id) => {
      for (const section of document.querySelectorAll<HTMLElement>("main > section")) {
        section.hidden = section.id !== id;
      }
    },
    setHref: (id, href) => {
      (document.getElementById(id) as HTMLAnchorElement).href = href;
    },
    onLoad: (fn) => addEventListener("load", fn),
    onTap: (fn) =>
      document.getElementById("open")?.addEventListener("click", (e) => {
        e.preventDefault();
        fn();
      }),
    later: (fn, ms) => {
      setTimeout(fn, ms);
    },
    navigate: (url) => {
      location.href = url;
    },
    doc: document,
    win: window,
    testflightUrl: import.meta.env.VITE_TESTFLIGHT_URL,
  });
</script>
