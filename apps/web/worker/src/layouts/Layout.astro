---
import { siteHeader } from "@eyes/ui/header";
import sprite from "@eyes/ui/icons.svg?raw";
import { LIVE_PAYOUTS } from "../api.ts";
import Icon from "../components/Icon.astro";
import "../styles/global.css";

interface Props {
  title: string;
  ogTitle?: string;
  description?: string;
  wide?: boolean;
  /** Internal pages (design references): keep them out of search results. */
  noindex?: boolean;
}

const { title, ogTitle, description, wide = false, noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#212121" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {ogTitle && <meta property="og:title" content={LIVE_PAYOUTS ? ogTitle : title} />}
    {description && <meta property="og:description" content={LIVE_PAYOUTS ? description : "No real money yet. These are test tasks."} />}
  </head>
  <body class="ui">
    <Fragment set:html={sprite} />
    <Fragment set:html={siteHeader()} />
    <main class:list={["page", { "page--wide": wide }]}>
      {!LIVE_PAYOUTS && (
        <p id="simulated" class="ui-notice">
          <Icon name="info" />
          <span><strong>No real money yet.</strong> These are test tasks.</span>
        </p>
      )}
      <slot />
    </main>
  </body>
</html>
