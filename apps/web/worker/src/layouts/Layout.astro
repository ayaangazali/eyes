---
import { siteHeader } from "@eyes/ui/header";
import sprite from "@eyes/ui/icons.svg?raw";
import { LIVE_PAYOUTS } from "../api.ts";
import Icon from "../components/Icon.astro";
import "../styles/global.css";

interface Props {
  title: string;
  ogTitle?: string;
  description?: string;
  wide?: boolean;
  /** Keep worker pages out of search results by default. */
  noindex?: boolean;
}

const {
  title,
  ogTitle,
  description = "Manage your Eyes tasks and account.",
  wide = false,
  noindex = true,
} = Astro.props;
const summary = LIVE_PAYOUTS ? description : "No real money yet. These are test tasks.";
const canonical = new URL(
  Astro.url.pathname.replace(/(?:index)?\.html$/, "").replace(/\/$/, "") || "/",
  "https://app.eyes.pictures",
).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#212121" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://eyes.pictures/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <meta name="description" content={summary} />
    <meta property="og:title" content={LIVE_PAYOUTS ? (ogTitle ?? title) : title} />
    <meta property="og:description" content={summary} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://eyes.pictures/images/share.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A storefront photographed for an Eyes task." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://eyes.pictures/images/share.jpg" />
  </head>
  <body class="ui">
    <Fragment set:html={sprite} />
    <Fragment set:html={siteHeader()} />
    <main class:list={["page", { "page--wide": wide }]}>
      {!LIVE_PAYOUTS && (
        <p id="simulated" class="ui-notice">
          <Icon name="info" />
          <span><strong>No real money yet.</strong> These are test tasks.</span>
        </p>
      )}
      <slot />
    </main>
  </body>
</html>
