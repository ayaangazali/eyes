---
import Layout from "../layouts/Layout.astro";

const APP = "https://app.eyes.pictures";
const API = "https://api.eyes.pictures";
const MCP = "https://mcp.eyes.pictures/mcp";

const steps = [
  ["Ask", "Your agent calls quote_task, then ask_eyes with a question, a place, a bounty and a deadline."],
  ["Text", "Eyes texts up to three people within 3 km over iMessage. The first to reply YES gets the task."],
  [
    "Photo",
    "They walk over and take one live photo. No gallery uploads, and GPS has to put them within 150 m.",
  ],
  [
    "Answer",
    "A vision model checks the photo, your agent gets the answer with its proof, and the worker gets paid.",
  ],
];

// Verified with mcp-use 2.10.1 against the live API. The default auto protocol times out on this
// server, so connect pins the legacy (initialize) handshake.
const CLI = "npx -y mcp-use@2.10.1";

const signup = `curl -X POST ${API}/v1/signup \\
  -H "content-type: application/json" \\
  -d '{"name":"my-agent"}'`;

const connect = `${CLI} client connect eyes ${MCP} \\
  --protocol legacy -H "Authorization: Bearer $EYES_API_KEY"`;

const tryIt = `${CLI} client eyes tools call quote_task \\
  location="Ferry Building, San Francisco" task_type=is_open`;

const answer = `// await_answer
{
  "status": "paid",
  "answer": {
    "answer_text": "Two cartons left",
    "answer_bool": true,
    "worker_distance_m": 41,
    "verification": { "gps_ok": true, "fresh_ok": true, "vision_ok": true },
    "confidence": 0.93,
    "cost_usd": 3.5
  }
}`;

// Real shapes of tasks agents send. Public places only.
const questions = [
  "Is the cafe on 18th St open right now?",
  "How long is the line at the Ferry Building?",
  "Is oat milk in stock at the Safeway on Market?",
  "Are there bikes at the 4th and King dock?",
  "Is the farmers market still set up?",
  "Is the pharmacy counter open?",
  "Is there a free table on the patio?",
  "Is the parking lot full?",
];

// Task in flight: one row per state, stamped like the event log an agent reads.
// hl maps each state to the step it belongs to in the list beside it.
const flight = [
  ["Asking", "12:04:10", "ask_eyes accepted, $3.50 held", 0],
  ["Texting", "12:04:12", "Texted 3 people within 3 km", 1],
  ["Claimed", "12:05:01", "YES from a worker 0.4 km away", 1],
  ["Photo in", "12:09:37", "Live photo received, 41 m from the store", 2],
  ["Verified", "12:09:40", "Answer sent to your agent, worker paid", 3],
] as const;
---

<Layout
  title="Eyes: your agent asks, someone nearby looks"
  description="Eyes pays someone near a place to take a live photo, then returns a verified answer to your AI agent in minutes."
>
  <link slot="head" rel="preload" as="image" href="/images/storefront.webp" imagesrcset="/images/storefront-640.webp 640w, /images/storefront-1080.webp 1080w, /images/storefront.webp 1536w" imagesizes="(min-width: 1152px) 632px, (min-width: 768px) 55vw, calc(100vw - 40px)" />

  <main>
    <section class="mx-auto grid max-w-6xl gap-10 px-5 pt-14 pb-16 md:grid-cols-12 md:pt-20 md:pb-24">
      <h1 class="hero-title m-0 font-semibold text-balance md:col-span-12">
        <span>Your agent asks.</span>
        <span class="text-secondary">Someone nearby looks.</span>
      </h1>
      <div class="grid content-center gap-6 md:col-span-5">
        <p class="m-0 max-w-[34ch] text-lg text-secondary md:text-xl">
          Eyes pays a person near the place to take a live photo, then hands your agent a verified answer in
          minutes.
        </p>
        <div class="pair">
          <button class="ui-button ui-button--primary" type="button" data-connect aria-haspopup="dialog">Connect your agent</button>
          <a class="ui-button" href={APP}>Earn as a worker</a>
        </div>
      </div>
      <figure class="m-0 grid gap-3 md:col-span-7">
        <div class="ui-viewfinder focus">
          <img
            src="/images/storefront.webp"
            srcset="/images/storefront-640.webp 640w, /images/storefront-1080.webp 1080w, /images/storefront.webp 1536w"
            sizes="(min-width: 1152px) 632px, (min-width: 768px) 55vw, calc(100vw - 40px)"
            width="1536"
            height="1024"
            alt="A corner coffee shop with an OPEN sign on the door and a chalkboard menu on the sidewalk"
          />
          <span class="hud hud--top ui-badge ui-badge--accent">AF locked</span>
          <span class="hud hud--bottom ui-num">38 m away, 6 min after the ask</span>
        </div>
        <figcaption class="text-sm text-secondary">"Is the cafe on 18th St open?" Yes.</figcaption>
      </figure>
    </section>

    <div class="marquee" aria-label="Questions agents ask">
      <button class="marquee__pause ui-button" type="button" aria-label="Pause questions" aria-pressed="false" aria-controls="questions">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path class="marquee__pause-icon" d="M9 5v14M15 5v14" />
          <path class="marquee__play-icon" d="m8 5 11 7-11 7Z" />
        </svg>
      </button>
      <div class="marquee__window">
        <ul id="questions" class="marquee__track">
          {questions.map((q) => <li>{q}</li>)}
          {questions.map((q) => <li aria-hidden="true">{q}</li>)}
        </ul>
      </div>
    </div>

    <section id="how">
      <div class="how mx-auto grid max-w-6xl items-start gap-12 px-5 py-20 md:grid-cols-12">
        <div class="grid gap-10 md:col-span-5">
          <div class="grid gap-4">
            <h2 class="section-title wipe m-0 font-semibold">From a question to a photo in four moves</h2>
            <p class="m-0 text-lg text-secondary">
              Agents can read the whole internet, but not what is happening on the street right now.
            </p>
          </div>
          <ol class="steps m-0 grid list-none gap-6 p-0">
            {
              steps.map(([title, body], i) => (
                <li
                  class:list={["step grid grid-cols-[2.5rem_1fr] items-baseline gap-x-3 gap-y-1", { "is-now": i === steps.length - 1 }]}
                  data-step={i}
                >
                  <span class="ui-num step__n">0{i + 1}</span>
                  <h3 class="m-0 text-xl font-semibold">{title}</h3>
                  <p class="col-start-2 m-0 text-secondary">{body}</p>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="flight brackets md:col-span-6 md:col-start-7" data-step="4" aria-live="off">
          <div class="flex items-center gap-3">
            <span class="ui-badge ui-badge--accent">
              <span class="t-text-swap" id="flight-status">{flight[4][0]}</span>
            </span>
            <span class="ui-num ml-auto text-sm text-secondary">task in flight</span>
          </div>
          <p class="flight__q m-0 font-semibold">"Is there oat milk at the Safeway on Market St?"</p>
          <p class="ui-place">
            <svg class="ui-icon" aria-hidden="true"><use href="#i-pin"></use></svg>
            <span>
              <span class="ui-place__name">Safeway, 2020 Market St</span>
              <span class="ui-place__address">Bounty $3.50, deadline 20 min</span>
            </span>
          </p>
          <ol class="flight__log m-0 grid list-none gap-2 p-0">
            {
              flight.map(([state, time, text, hl], i) => (
                <li data-at={i} data-state={state} data-hl={hl}>
                  <span class="ui-num text-secondary">{time}</span>
                  <span>{text}</span>
                </li>
              ))
            }
          </ol>
          <ul class="ui-checks flight__checks">
            <li class="ui-check ui-check--pass">
              <span class="ui-check__mark t-success-check"><svg class="ui-icon" aria-hidden="true"><use href="#i-check"></use></svg></span>
              <span>GPS within 150 m</span>
              <span class="ui-check__detail">41 m</span>
            </li>
            <li class="ui-check ui-check--pass">
              <span class="ui-check__mark t-success-check"><svg class="ui-icon" aria-hidden="true"><use href="#i-check"></use></svg></span>
              <span>Live, before the deadline</span>
              <span class="ui-check__detail">4 min</span>
            </li>
            <li class="ui-check ui-check--pass">
              <span class="ui-check__mark t-success-check"><svg class="ui-icon" aria-hidden="true"><use href="#i-check"></use></svg></span>
              <span>Photo is safe to share</span>
              <span class="ui-check__detail">0.93</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="band__photo ui-viewfinder">
        <img
          src="/images/shelf.webp"
          srcset="/images/shelf-640.webp 640w, /images/shelf.webp 1024w"
          sizes="100vw"
          width="1024"
          height="1536"
          loading="lazy"
          alt="Two cartons of oat milk on a grocery shelf beside an empty gap"
        />
      </div>
      <div class="band__inner mx-auto grid max-w-6xl px-5">
        <div class="band__card brackets grid gap-6">
          <p class="band__answer wipe m-0 font-semibold">"Two cartons left."</p>
          <h2 class="m-0 text-2xl font-semibold tracking-tight">An answer you can check</h2>
          <p class="m-0 text-secondary">
            Your agent gets the photo, the worker's answer and three checks. If any check fails, the money stays held
            for review instead of paying out.
          </p>
          <ul class="ui-checks text-base">
            <li class="ui-check ui-check--pass">
              <span class="ui-check__mark"><svg class="ui-icon" aria-hidden="true"><use href="#i-check"></use></svg></span>
              <span>The worker stood within 150 m of the place</span>
              <span class="ui-check__detail">41 m</span>
            </li>
            <li class="ui-check ui-check--pass">
              <span class="ui-check__mark"><svg class="ui-icon" aria-hidden="true"><use href="#i-check"></use></svg></span>
              <span>The photo was taken live, before the deadline</span>
              <span class="ui-check__detail">4 min</span>
            </li>
            <li class="ui-check ui-check--pass">
              <span class="ui-check__mark"><svg class="ui-icon" aria-hidden="true"><use href="#i-check"></use></svg></span>
              <span>Photo is safe to share</span>
              <span class="ui-check__detail">0.93</span>
            </li>
            <li class="ui-check">
              <span class="ui-check__mark"><svg class="ui-icon" aria-hidden="true"><use href="#i-no-face"></use></svg></span>
              <span>Only confirmed graphic gore or explicit sexual content is blocked</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section id="agents" class="bg-surface-secondary">
      <div class="mx-auto grid max-w-6xl items-start gap-10 px-5 py-20 md:grid-cols-12 md:py-32">
        <div class="grid gap-5 md:col-span-5 md:sticky md:top-24">
          <h2 class="section-title wipe m-0 font-semibold">Built for agents first</h2>
          <p class="m-0 text-lg text-secondary">
            Connect Eyes to ChatGPT or Claude in your browser. Copy the server URL, add a custom connector, and sign in with your Eyes key.
            No terminal required.
          </p>
          <p class="m-0 text-sm text-secondary">
            Use another MCP client? The advanced instructions below cover those too.
          </p>
          <p class="m-0 flex flex-wrap gap-x-4 gap-y-1 text-sm text-secondary">
            <span>Docs for agents</span>
            <a class="ui-link" href={`${API}/llms.txt`}>llms.txt</a>
            <a class="ui-link" href={`${API}/openapi.json`}>openapi.json</a>
            <a class="ui-link" href="https://docs.manufact.com/cli">Manufact CLI</a>
            <a class="ui-link" href={`${API}/status`}>Live status</a>
          </p>
        </div>
        <div class="grid min-w-0 gap-10 md:col-span-7">
          <div class="grid gap-4">
            <h3 class="m-0 text-xl font-semibold">ChatGPT or Claude, in your browser</h3>
            <p class="m-0 text-secondary">Your agent can check a place, see a live photo, and return a verified answer.</p>
            <button class="ui-button ui-button--primary justify-self-start" type="button" data-connect aria-haspopup="dialog">Choose ChatGPT or Claude</button>
            <p class="m-0 text-sm text-secondary">Custom connector setup. Availability depends on your app, account and workspace permissions.</p>
          </div>
          <details class="min-w-0">
            <summary class="ui-link cursor-pointer">Advanced: CLI &amp; other clients</summary>
            <p class="text-sm text-secondary">
              Other MCP clients can use <code class="font-mono break-all">{MCP}</code> with an Authorization: Bearer header.
              <a class="ui-link" href="https://github.com/ayaangazali/eyes/blob/main/docs/CONNECT.md">Full client instructions</a>
            </p>
          <ol class="m-0 grid list-none gap-10 p-0">
            <li class="grid min-w-0 gap-3">
              <span class="ui-num step__n">01</span>
              <h3 class="m-0 text-xl font-semibold">Get a key</h3>
              <pre data-focus class="code" tabindex="0" role="region" aria-label="Get an API key"><code>{signup}</code></pre>
              <p class="m-0 text-sm text-secondary">
                The response holds api_key, shown once. Test mode grants $20. Save it with{" "}
                <code class="font-mono">export EYES_API_KEY=...</code>
              </p>
            </li>
            <li class="grid min-w-0 gap-3">
              <span class="ui-num step__n">02</span>
              <h3 class="m-0 text-xl font-semibold">Connect with the Manufact CLI</h3>
              <pre data-focus class="code" tabindex="0" role="region" aria-label="Connect with the Manufact CLI"><code>{connect}</code></pre>
              <p class="m-0 text-sm text-secondary">Saves the server as eyes. No global install needed.</p>
            </li>
            <li class="grid min-w-0 gap-3">
              <span class="ui-num step__n">03</span>
              <h3 class="m-0 text-xl font-semibold">Try it</h3>
              <pre data-focus class="code" tabindex="0" role="region" aria-label="Try a quote"><code>{tryIt}</code></pre>
              <p class="m-0 text-sm text-secondary">
                quote_task is free and read-only. Look for "allowed": true, then ask_eyes posts a real task. When a
                worker answers, await_answer returns:
              </p>
            </li>
          </ol>
          <pre data-focus class="code" tabindex="0" role="region" aria-label="Example answer"><code>{answer}</code></pre>
          </details>
        </div>
      </div>
    </section>

    <section id="workers">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-20 md:grid-cols-12 md:py-32">
        <p class="pay wipe m-0 font-semibold md:col-span-5" aria-hidden="true"><span>$3</span></p>
        <div class="grid gap-10 md:col-span-7">
          <div class="grid gap-5">
            <h2 class="section-title wipe m-0 font-semibold">Get paid to look around</h2>
            <p class="m-0 text-lg text-secondary">
              Checks usually pay $3 and take a few minutes. Tasks only come from public places: stores, cafes, transit
              stops, parks.
            </p>
            <div class="pair">
              <a class="ui-button ui-button--primary" href={APP}>Join on your phone</a>
              <a class="ui-button" href="/privacy">Privacy note</a>
            </div>
          </div>
          <dl class="m-0 grid content-start gap-x-8 gap-y-6 sm:grid-cols-2">
            <div data-focus class="grid gap-1 border-t border-subtle pt-4">
              <dt class="font-semibold">An iPhone</dt>
              <dd class="m-0 text-secondary">Tasks arrive over iMessage. Reply YES to claim one.</dd>
            </div>
            <div data-focus class="grid gap-1 border-t border-subtle pt-4">
              <dt class="font-semibold">One live photo</dt>
              <dd class="m-0 text-secondary">The link opens your camera at the place. Avoid photographing private individuals without permission.</dd>
            </div>
            <div data-focus class="grid gap-1 border-t border-subtle pt-4">
              <dt class="font-semibold">Paid on verify</dt>
              <dd class="m-0 text-secondary">Payouts go through Stripe once the photo checks out.</dd>
            </div>
            <div data-focus class="grid gap-1 border-t border-subtle pt-4">
              <dt class="font-semibold">Stop any time</dt>
              <dd class="m-0 text-secondary">Text STOP and the texts stop. START turns them back on.</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section id="pricing" class="bg-surface-secondary">
      <div class="mx-auto grid max-w-6xl items-start gap-12 px-5 py-20 md:grid-cols-12 md:py-32">
        <div class="grid gap-8 md:col-span-5">
          <h2 class="section-title wipe m-0 font-semibold">Pricing and trust</h2>
          <div class="ui-card">
            <p class="m-0 font-semibold">Default task</p>
            <p class="ui-num m-0 text-lg">$3.00 to the worker + $0.50 Eyes fee <span class="whitespace-nowrap">= $3.50</span></p>
          </div>
        </div>
        <dl class="m-0 grid content-start gap-x-8 gap-y-6 md:col-span-7 sm:grid-cols-2">
          <div data-focus class="grid content-start gap-1 border-t border-subtle pt-4">
            <dt class="font-semibold">What an agent pays</dt>
            <dd class="m-0 text-secondary">The bounty to the worker: $3.00 by default. The agent can set more within its spend policy ($10 per task by default, $50 at most). Plus a $0.50 Eyes fee per task.</dd>
          </div>
          <div data-focus class="grid content-start gap-1 border-t border-subtle pt-4">
            <dt class="font-semibold">Only when it's sent</dt>
            <dd class="m-0 text-secondary">Nothing is charged if no one is nearby. While the task is open, the money is held. If it expires or is cancelled, it is refunded in full.</dd>
          </div>
          <div data-focus class="grid content-start gap-1 border-t border-subtle pt-4">
            <dt class="font-semibold">Where the money comes from</dt>
            <dd class="m-0 text-secondary">Agents top up a prepaid balance by card through Stripe Checkout. New agents start with $20 of test credit. Payments run in Stripe test mode today.</dd>
          </div>
          <div data-focus class="grid content-start gap-1 border-t border-subtle pt-4">
            <dt class="font-semibold">Workers</dt>
            <dd class="m-0 text-secondary">Workers keep the whole bounty. It is paid to their bank through Stripe once the photo passes the checks.</dd>
          </div>
          <div data-focus class="grid content-start gap-1 border-t border-subtle pt-4">
            <dt class="font-semibold">What Eyes checks</dt>
            <dd class="m-0 grid gap-3 text-secondary">
              <ul class="ui-checks m-0 list-none p-0">
                <li class="ui-check ui-check--pass"><span class="ui-check__mark"><svg class="ui-icon" aria-hidden="true"><use href="#i-check"></use></svg></span><span>Taken at the place</span><span class="ui-check__detail">within 150 m</span></li>
                <li class="ui-check ui-check--pass"><span class="ui-check__mark"><svg class="ui-icon" aria-hidden="true"><use href="#i-check"></use></svg></span><span>Taken just now</span><span class="ui-check__detail">under 5 min old</span></li>
                <li class="ui-check ui-check--pass"><span class="ui-check__mark"><svg class="ui-icon" aria-hidden="true"><use href="#i-check"></use></svg></span><span>Content moderation</span><span class="ui-check__detail">graphic gore or explicit sexual content only</span></li>
              </ul>
              <p class="m-0">Eyes does not judge whether the answer is right. The agent sees the photo.</p>
            </dd>
          </div>
          <div data-focus class="grid content-start gap-1 border-t border-subtle pt-4">
            <dt class="font-semibold">If an answer is fake</dt>
            <dd class="m-0 text-secondary">A human disputes it. Eyes reviews the photo. If it's fake, the agent gets a full refund and the worker is banned.</dd>
          </div>
        </dl>
      </div>
    </section>
  </main>

  <dialog id="connect-dialog" class="connect-dialog" aria-labelledby="connect-title" aria-describedby="connect-intro">
    <div class="grid gap-5">
      <div class="flex items-start justify-between gap-4">
        <h2 id="connect-title" class="m-0 text-2xl font-semibold" tabindex="-1" autofocus>Connect Eyes</h2>
        <form method="dialog"><button class="ui-button ui-button--sm" type="submit">Close</button></form>
      </div>
      <p id="connect-intro" class="m-0 text-secondary">Set up a custom connector in your browser. No terminal required.</p>
      <div class="grid gap-2">
        <label for="connect-client" class="font-semibold">Choose your app</label>
        <select id="connect-client" class="ui-input appearance-auto">
          <option value="chatgpt">ChatGPT</option>
          <option value="claude">Claude</option>
        </select>
      </div>
      <div class="grid gap-2">
        <label for="connect" class="font-semibold">MCP server URL</label>
        <div class="connect-url">
          <input id="connect" class="font-mono" type="text" value={MCP} readonly spellcheck="false" />
          <button id="copy" class="ui-button" type="button" aria-label="Copy server URL">Copy</button>
        </div>
        <p id="copied" class="m-0 text-sm text-secondary" role="status" aria-live="polite">Copy this URL, not a terminal command.</p>
      </div>
      <section id="chatgpt-connect" class="grid gap-5" aria-label="ChatGPT setup">
      <a id="open-chatgpt" class="ui-button ui-button--primary justify-self-start" href="https://chatgpt.com/plugins" target="_blank" rel="noopener noreferrer">Open ChatGPT <span class="sr-only">(new tab)</span></a>
      <ol class="m-0 grid list-decimal gap-3 pl-5">
        <li>In <strong>Plugins</strong>, choose <strong>Add / + &gt; Add custom MCP server</strong>. Already added Eyes? Open it and resume <strong>Connect</strong> instead.</li>
        <li>Name it <strong>Eyes</strong>, paste the server URL above, and choose <strong>OAuth</strong> authentication.</li>
        <li>Check <strong>I understand and want to continue</strong>, then choose <strong>Create as a plugin</strong> and <strong>Connect</strong>.</li>
        <li>After creating a key on the Eyes page, click <strong>Continue to ChatGPT</strong>; your app receives it automatically. Save the key only if you want direct API access. If using an <strong>existing Eyes API key</strong>, enter it on that page and click <strong>Connect</strong>. Never paste a key into chat. Connecting does not charge a card.</li>
        <li>In a new chat, type <strong>@</strong> and select <strong>Eyes</strong>. Try: “Use Eyes to quote checking whether the Ferry Building in San Francisco is open.” A quote is free.</li>
      </ol>
      <details class="text-sm text-secondary">
        <summary class="ui-link cursor-pointer">Account requirements &amp; public listing</summary>
        <p>The current Plugins flow does not require Developer Mode. Custom MCP is web-only and depends on account access, workspace policy, and Lockdown settings. If Add custom MCP server is missing or disabled, check access with your workspace admin.</p>
        <p>Pro supports read/fetch permissions; full MCP support is available on Business, Enterprise and Edu. Business requires an admin or owner to create workspace plugins. Enterprise/Edu also allow creators with the “Create plugins with MCPs” permission; only admins/owners publish to the workspace. Free and Plus access is not guaranteed.</p>
        <p>This is a custom connector, not a public marketplace install. A public listing requires OpenAI review, approval, and publishing.</p>
        <p><a class="ui-link" href="https://help.openai.com/en/articles/12584461-connecting-custom-mcp-servers-in-chatgpt" target="_blank" rel="noopener noreferrer">ChatGPT requirements</a> · <a class="ui-link" href="https://developers.openai.com/plugins/deploy/app-review" target="_blank" rel="noopener noreferrer">Public listing review</a></p>
      </details>
      </section>
      <section id="claude-connect" class="grid gap-5" aria-label="Claude setup" hidden>
        <a id="open-claude" class="ui-button ui-button--primary justify-self-start" href="https://claude.ai/customize/connectors" target="_blank" rel="noopener noreferrer">Open Claude <span class="sr-only">(new tab)</span></a>
        <ol class="m-0 grid list-decimal gap-3 pl-5">
          <li>In <strong>Customize &gt; Connectors</strong>, choose <strong>+ Add &gt; Add custom connector</strong>. Already added Eyes? Open it and resume <strong>Connect</strong> instead.</li>
          <li>Name it <strong>Eyes</strong>, paste the server URL above with no trailing slash, and choose <strong>Continue</strong>.</li>
          <li>Keep the detected <strong>Sign in now</strong> and <strong>Register automatically</strong> settings, add the connector, then choose <strong>Connect</strong>.</li>
          <li>After creating a key on the Eyes page, click <strong>Continue to Claude</strong>; your app receives it automatically. Save the key only if you want direct API access. If using an <strong>existing Eyes API key</strong>, enter it on that page and click <strong>Connect</strong>. Never paste a key into chat. Connecting does not charge a card.</li>
          <li>In a new chat, open <strong>+ &gt; Connectors</strong> and enable <strong>Eyes</strong>. Try: “Use Eyes to quote checking whether the Ferry Building in San Francisco is open.” A quote is free.</li>
        </ol>
        <details class="text-sm text-secondary">
          <summary class="ui-link cursor-pointer">Claude account requirements</summary>
          <p>Custom connectors are available on Free, Pro, Max, Team and Enterprise. Free is limited to one custom connector.</p>
          <p>On Team, an Owner or Primary Owner must add the organization connector first. Enterprise also allows a custom role with “Manage access to Libraries”. Each member then connects individually from Customize.</p>
          <p>This is custom connector setup, not a one-click install or a claim that Eyes is listed in the connector directory.</p>
          <p><a class="ui-link" href="https://support.claude.com/en/articles/11175166-get-started-with-custom-connectors-using-remote-mcp" target="_blank" rel="noopener noreferrer">Claude connector requirements</a></p>
        </details>
      </section>
    </div>
  </dialog>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { createFlight, wireCopy } from "../motion.ts";

    const pause = document.querySelector<HTMLButtonElement>(".marquee__pause")!;
    pause.addEventListener("click", () => {
      const paused = pause.getAttribute("aria-pressed") !== "true";
      pause.setAttribute("aria-pressed", String(paused));
      pause.setAttribute("aria-label", paused ? "Play questions" : "Pause questions");
    });

    const dialog = document.getElementById("connect-dialog") as HTMLDialogElement;
    let opener: HTMLElement;
    document.querySelectorAll<HTMLElement>("[data-connect]").forEach((button) => {
      button.addEventListener("click", () => {
        opener = button;
        dialog.showModal();
      });
    });
    dialog.addEventListener("close", () => opener?.focus());
    const client = document.getElementById("connect-client") as HTMLSelectElement;
    client.addEventListener("change", () => {
      document.getElementById("chatgpt-connect")!.hidden = client.value !== "chatgpt";
      document.getElementById("claude-connect")!.hidden = client.value !== "claude";
      dialog.scrollTop = 0;
    });

    wireCopy(
      document.getElementById("copy"),
      document.getElementById("connect"),
      document.getElementById("copied") as HTMLElement,
      (text) => navigator.clipboard.writeText(text),
    );

    /*
     * Scroll-scrubbed motion: every tween below is tied to scroll position (scrub), so scrolling back
     * plays it backwards exactly. The markup is the final state (Verified, all rows, all checks), so
     * without JS or with reduced motion nothing is hidden and nothing moves.
     */
    gsap.registerPlugin(ScrollTrigger);

    const main = document.querySelector("main") as HTMLElement;
    const panel = main.querySelector(".flight") as HTMLElement;
    const status = main.querySelector("#flight-status") as HTMLElement;
    const rows = [...panel.querySelectorAll<HTMLElement>("[data-at]")];
    const marks = [...panel.querySelectorAll<HTMLElement>(".t-success-check")];
    const stepList = main.querySelector(".steps") as HTMLElement;
    const steps = [...stepList.querySelectorAll<HTMLElement>(".step")];
    const last = rows.length - 1;
    // Discrete state: the badge label (transitions.dev "Text states swap") and the lit step.
    const { show } = createFlight({ panel, status, steps, rows });

    // Task in flight, one timeline unit per state. Row n fades in over [n - 0.7, n - 0.1] and the
    // state flips at its midpoint; then the checks tick (10 Success check values) and the brackets lock.
    // One tween per row and per check (a staggered fromTo only pre-renders its first target, so
    // rows not reached yet would show at full strength before the scrub got to them).
    const flightTimeline = () => {
      const tl = gsap.timeline({
        defaults: { ease: "none" },
        onUpdate: () => show(Math.min(last, Math.floor(tl.time() + 0.4))),
      });
      rows.slice(1).forEach((row, i) => {
        tl.fromTo(row, { opacity: 0 }, { opacity: 1, duration: 0.6 }, i + 0.3);
      });
      marks.forEach((mark, i) => {
        tl.fromTo(
          mark,
          { opacity: 0, rotate: 80, scale: 0.6 },
          { opacity: 1, rotate: 0, scale: 1, duration: 0.4 },
          3.9 + i * 0.15,
        );
      });
      return tl
        .fromTo(panel, { "--lock": 0, "--lock-o": 0 }, { "--lock": 1, "--lock-o": 1, duration: 0.4 }, 4.5)
        .to({}, { duration: 0.1 }, 4.9);
    };

    const scrub = 0.5;

    gsap.context(() => {
      const mm = gsap.matchMedia();
      mm.add(
        { wide: "(min-width: 768px)", narrow: "(max-width: 767px)", still: "(prefers-reduced-motion: reduce)" },
        ({ conditions }) => {
          if (conditions?.still) return;
          const wide = Boolean(conditions?.wide);

          // #how: on wide screens pinned for about a screen and a quarter and scrubbed through the
          // four steps, so every scroll step moves the story. Phones show all four steps and the
          // finished panel as they are: no pin, no dimmed steps, nothing to scroll past.
          if (wide) {
            stepList.classList.add("is-live");
            show(0);
            ScrollTrigger.create({
              animation: flightTimeline(),
              trigger: "#how",
              start: "top top",
              end: () => `+=${innerHeight * 1.25}`,
              pin: true,
              scrub,
              refreshPriority: 1,
              invalidateOnRefresh: true,
            });
          }

          // Hero: the photo loads sharp after one short focus pull (time-based, not scroll). Scroll then
          // only locks the brackets, shows the labels and eases the frame back a little. No scrubbed blur
          // anywhere: an idle reader must never be left looking at a blurred element.
          const vf = main.querySelector(".focus") as HTMLElement;
          gsap.fromTo(vf.querySelector("img"), { filter: "blur(6px)" }, { filter: "blur(0px)", duration: 0.6, ease: "power2.out", clearProps: "filter" });
          gsap
            .timeline({
              defaults: { ease: "none" },
              scrollTrigger: { trigger: vf.closest("section"), start: "top top", end: "bottom top", scrub },
            })
            .fromTo(vf, { "--vf-inset": "-28px" }, { "--vf-inset": "12px", duration: 0.35 }, 0)
            .fromTo(".hud", { opacity: 0 }, { opacity: 1, duration: 0.1 }, 0.28)
            .fromTo(vf, { scale: 1 }, { scale: 0.96, duration: 0.65 }, 0.35);

          // Shelf band: the photo zooms out across the whole pass, its brackets close in, and the card
          // fades up, locks and lets go.
          gsap.fromTo(".band__photo img", { scale: 1.18 }, {
            scale: 1,
            ease: "none",
            scrollTrigger: { trigger: ".band", start: "clamp(top bottom)", end: "clamp(bottom top)", scrub },
          });
          gsap.fromTo(".band__photo", { "--vf-inset": "-24px" }, {
            "--vf-inset": "24px",
            ease: "none",
            scrollTrigger: { trigger: ".band", start: "clamp(top 80%)", end: "clamp(top 20%)", scrub },
          });
          gsap
            .timeline({
              defaults: { ease: "none" },
              scrollTrigger: { trigger: ".band__card", start: "clamp(top 90%)", end: "clamp(top 35%)", scrub },
            })
            .fromTo(".band__card", { scale: 0.98 }, { scale: 1, duration: 0.6 }, 0)
            .fromTo(".band__card", { "--lock": 0, "--lock-o": 0 }, { "--lock": 1, "--lock-o": 1, duration: 0.5 }, 0.3)
            .to(".band__card", { "--lock-o": 0, duration: 0.2 }, 0.8);

          // Headlines wipe in left to right as they cross the screen.
          for (const el of gsap.utils.toArray<HTMLElement>(".wipe"))
            gsap.fromTo(el, { clipPath: "inset(-0.3em 100% -0.3em 0%)" }, {
              clipPath: "inset(-0.3em -2% -0.3em 0%)",
              ease: "none",
              scrollTrigger: { trigger: el, start: "clamp(top 85%)", end: "clamp(top 45%)", scrub },
            });

          // Code blocks and worker facts fade up in place.
          for (const el of gsap.utils.toArray<HTMLElement>("[data-focus]"))
            gsap.fromTo(el, { opacity: 0.35 }, {
              opacity: 1,
              ease: "none",
              scrollTrigger: { trigger: el, start: "clamp(top 92%)", end: "clamp(top 65%)", scrub },
            });

          return () => {
            stepList.classList.remove("is-live");
            show(last);
          };
        },
      );
    }, main);

    // clamp() keeps every range inside the page, so triggers near the bottom still reach progress 1.
    // Safety net: any trigger that still ends past the last scroll position is shown finished.
    ScrollTrigger.addEventListener("refresh", () => {
      const max = ScrollTrigger.maxScroll(window);
      for (const st of ScrollTrigger.getAll()) if (!st.pin && st.end > max) st.animation?.progress(1);
    });
    document.fonts.ready.then(() => ScrollTrigger.refresh());
  </script>
</Layout>

<style>
  /*
   * From transitions.dev (https://transitions.dev, MIT,
   * github.com/Jakubantalik/transitions.dev/skills/transitions-dev): 04 Text states swap is vendored
   * below; 10 Success check values (80deg rotate, scale pop) drive the scrubbed check tween.
   */
  :root {
    --text-swap-dur: 150ms;
    --text-swap-translate-y: 4px;
    --text-swap-blur: 2px;
    /* The badge label enters, so the strong ease-out (transitions.dev ships ease-in-out). */
    --text-swap-ease: var(--eyes-ease-out);
  }

  /* Type scale: display headline, section titles, one giant numeral. */
  .hero-title {
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
  }
  .hero-title > span {
    display: block;
  }
  .section-title {
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  /* Hero viewfinder: brackets pull in from outside the frame and lock while the photo comes into focus. */
  .ui-viewfinder {
    border-radius: var(--eyes-radius-2xl);
  }
  .focus {
    --bracket: 2rem;
    --bracket-width: 4px;
  }
  .focus::before {
    inset: var(--vf-inset, var(--eyes-space-3));
  }
  .hud {
    position: absolute;
    z-index: 3;
    left: var(--eyes-space-6);
  }
  .hud--top {
    top: var(--eyes-space-6);
  }
  .hud--bottom {
    bottom: var(--eyes-space-6);
    padding: 0.125rem 0.5rem;
    border-radius: var(--eyes-radius-full);
    background: rgb(0 0 0 / 55%);
    color: #fff;
    font-size: var(--eyes-text-xs);
    backdrop-filter: blur(6px);
  }

  /* Marquee band: the one loud surface. Yellow in both themes. */
  .marquee {
    --marquee-control-inset: max(var(--eyes-space-5), calc((100% - var(--ui-column)) / 2 + var(--eyes-space-5)));
    position: relative;
    background: var(--eyes-accent);
    color: var(--eyes-on-accent);
  }
  .marquee__window {
    overflow: hidden;
    margin-right: calc(var(--marquee-control-inset) + var(--eyes-tap) + var(--eyes-space-3));
    mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent);
  }
  .marquee .marquee__pause {
    position: absolute;
    z-index: 1;
    inset-block: 0;
    right: var(--marquee-control-inset);
    display: grid;
    place-items: center;
    width: var(--eyes-tap);
    height: var(--eyes-tap);
    margin-block: auto;
    padding: 0;
    border-radius: 50%;
    background: var(--eyes-on-accent);
    color: var(--eyes-accent);
  }
  .marquee__play-icon,
  .marquee__pause[aria-pressed="true"] .marquee__pause-icon {
    display: none;
  }
  .marquee__pause[aria-pressed="true"] .marquee__play-icon {
    display: block;
  }
  .marquee:has(:focus-visible) .marquee__track,
  .marquee:has([aria-pressed="true"]) .marquee__track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee .marquee__pause {
      display: none;
    }
    .marquee__window {
      margin-right: 0;
      mask-image: none;
    }
  }
  .marquee__track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 1.25rem 0;
    list-style: none;
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .marquee__track li {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding-right: 2.5rem;
    white-space: nowrap;
  }
  .marquee__track li::after {
    width: 0.9rem;
    height: 0.9rem;
    content: "";
    background:
      linear-gradient(currentColor 0 0) top left / 0.35rem 2px no-repeat,
      linear-gradient(currentColor 0 0) top left / 2px 0.35rem no-repeat,
      linear-gradient(currentColor 0 0) bottom right / 0.35rem 2px no-repeat,
      linear-gradient(currentColor 0 0) bottom right / 2px 0.35rem no-repeat;
  }

  /* Steps list: the current one is lit while the panel runs. */
  .step__n {
    color: var(--eyes-text-secondary);
    font-size: var(--eyes-text-sm);
    font-weight: 600;
  }
  /* Steps dim only while the scroll story runs; without it all four read at full strength. Dimmed
     means the secondary text token (4.5:1 or better), never opacity. */
  .steps.is-live .step:not(.is-now) h3 {
    color: var(--eyes-text-secondary);
    transition: color 250ms ease;
  }
  .step.is-now .step__n {
    color: var(--eyes-text);
    box-shadow: inset 0 -3px var(--eyes-accent);
    justify-self: start;
  }

  /* Task in flight: a real state readout built from ui-badge, ui-place and ui-check. */
  .flight {
    display: grid;
    gap: var(--eyes-space-5);
    padding: var(--eyes-space-6);
    border-radius: var(--eyes-radius-2xl);
    background: var(--eyes-surface-secondary);
    box-shadow: var(--eyes-hairline);
  }
  .flight__q {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .flight__log {
    min-height: 9.5rem;
    padding-top: var(--eyes-space-4);
    border-top: 1px solid var(--eyes-border-subtle);
    font-size: var(--eyes-text-sm);
  }
  .flight__log li {
    display: grid;
    grid-template-columns: 4.75rem 1fr;
    gap: var(--eyes-space-3);
  }
  .flight__log li:last-child {
    font-weight: 600;
  }
  .flight__checks {
    padding-top: var(--eyes-space-4);
    border-top: 1px solid var(--eyes-border-subtle);
  }

  /* Photo band: full bleed, the photo settles from zoomed in as it scrolls through. */
  .band {
    position: relative;
  }
  .band__photo {
    aspect-ratio: 4 / 5;
    border-radius: 0;
  }
  .band__photo::before {
    inset: var(--vf-inset, var(--eyes-space-6));
  }
  .band__inner {
    padding-block: var(--eyes-space-8);
  }
  .band__answer {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  @media (min-width: 768px) {
    .band {
      min-height: 52rem;
    }
    .band__photo {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }
    .band__inner {
      position: relative;
      z-index: 3;
      min-height: 52rem;
      align-content: end;
      justify-items: end;
      padding-block: var(--eyes-space-10);
    }
    .band__card {
      max-width: 30rem;
      padding: var(--eyes-space-8);
      border-radius: var(--eyes-radius-2xl);
      background: var(--eyes-surface);
      box-shadow: 0 24px 60px rgb(0 0 0 / 25%);
    }
  }

  .pay {
    font-size: clamp(9rem, 26vw, 20rem);
    line-height: 0.8;
    letter-spacing: -0.07em;
  }
  .pay span {
    box-shadow: inset 0 -0.12em var(--eyes-accent);
  }

  .code {
    margin: 0;
    overflow-x: auto;
    padding: var(--eyes-space-5);
    border-radius: var(--eyes-radius-xl);
    background: var(--eyes-surface);
    box-shadow: var(--eyes-hairline);
    font-family: var(--eyes-font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  /* Pinned on wide screens: the whole story has to fit one screen under the 64px header. */
  @media (min-width: 768px) {
    .how {
      min-height: 100dvh;
      align-content: center;
      padding-block: 6rem 2.5rem;
    }
  }

  /* Time-based motion left: the marquee loop and the badge label swap on a state change.
     Everything else is scrubbed by scroll in the script above. */
  @media (prefers-reduced-motion: no-preference) {
    .marquee__track {
      animation: marquee 48s linear infinite;
    }
    /* Pause on hover for a mouse only: on touch a tap would freeze the loop until the next tap. */
    @media (hover: hover) and (pointer: fine) {
      .marquee:hover .marquee__track {
        animation-play-state: paused;
      }
    }

    /* 04 Text states swap */
    .t-text-swap {
      display: inline-block;
      transition:
        transform var(--text-swap-dur) var(--text-swap-ease),
        filter var(--text-swap-dur) var(--text-swap-ease),
        opacity var(--text-swap-dur) var(--text-swap-ease);
    }
    .t-text-swap.is-exit {
      transform: translateY(calc(var(--text-swap-translate-y) * -1));
      filter: blur(var(--text-swap-blur));
      opacity: 0;
    }
    .t-text-swap.is-enter-start {
      transform: translateY(var(--text-swap-translate-y));
      filter: blur(var(--text-swap-blur));
      opacity: 0;
      transition: none;
    }
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
