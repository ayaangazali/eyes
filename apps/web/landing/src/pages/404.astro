---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found | Eyes" description="This page could not be found.">
  <meta slot="head" name="robots" content="noindex" />
  <main class="mx-auto grid min-h-[65vh] max-w-6xl content-center justify-items-start gap-6 px-5 py-20">
    <span class="ui-num text-secondary">404</span>
    <h1 class="m-0 text-5xl font-semibold tracking-tight">Page not found</h1>
    <a class="ui-button ui-button--primary" href="/">Back to home</a>
  </main>
</Layout>
