---
import sprite from "@eyes/ui/icons.svg?raw";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const APP = "https://app.eyes.pictures";
const API = "https://api.eyes.pictures";
// Section links stay in-page on the home page and point back to it elsewhere.
const home = ["/", "/index.html"].includes(Astro.url.pathname) ? "" : "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#212121" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:image" content="/images/storefront.webp" />
    <slot name="head" />
  </head>
  <body class="ui">
    <Fragment set:html={sprite} />

    <header class="sticky top-0 z-10 border-b border-subtle bg-surface/85 backdrop-blur">
      <nav class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5">
        <a href="/" class="flex items-center gap-2 text-lg font-semibold tracking-tight text-default no-underline">
          <span class="mark" aria-hidden="true"></span>Eyes
        </a>
        <div class="ml-auto hidden items-center gap-6 text-sm text-secondary md:flex">
          <a class="hover:text-default" href={`${home}#how`}>How it works</a>
          <a class="hover:text-default" href={`${home}#agents`}>For agents</a>
          <a class="hover:text-default" href={`${home}#workers`}>For workers</a>
          <a class="hover:text-default" href={`${home}#pricing`}>Pricing</a>
        </div>
        <a class="ui-button ui-button--sm ml-auto md:ml-0" href={APP}>Open the app</a>
      </nav>
    </header>

    <slot />

    <footer class="border-t border-subtle">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-5 py-8 text-sm text-secondary">
        <span class="flex items-center gap-2 font-semibold text-default"><span class="mark" aria-hidden="true"></span>Eyes</span>
        <span>Built at YC's Make Something Agents Want hackathon.</span>
        <a class="ml-auto hover:text-default" href={`${API}/status`}>Status</a>
        <a class="hover:text-default" href={`${API}/llms.txt`}>llms.txt</a>
        <a class="hover:text-default" href={APP}>App</a>
        <a class="hover:text-default" href="/terms">Terms</a>
        <a class="hover:text-default" href="/privacy">Privacy</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .mark {
    --b: 0.4rem;
    width: 1.25rem;
    height: 1.25rem;
    background:
      linear-gradient(var(--eyes-accent) 0 0) top left / var(--b) 2px no-repeat,
      linear-gradient(var(--eyes-accent) 0 0) top left / 2px var(--b) no-repeat,
      linear-gradient(var(--eyes-accent) 0 0) top right / var(--b) 2px no-repeat,
      linear-gradient(var(--eyes-accent) 0 0) top right / 2px var(--b) no-repeat,
      linear-gradient(var(--eyes-accent) 0 0) bottom left / var(--b) 2px no-repeat,
      linear-gradient(var(--eyes-accent) 0 0) bottom left / 2px var(--b) no-repeat,
      linear-gradient(var(--eyes-accent) 0 0) bottom right / var(--b) 2px no-repeat,
      linear-gradient(var(--eyes-accent) 0 0) bottom right / 2px var(--b) no-repeat,
      radial-gradient(circle, var(--eyes-text) 0 0.17rem, transparent 0.19rem) center / 100% 100% no-repeat;
  }
</style>
