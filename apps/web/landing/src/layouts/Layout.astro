---
import { siteHeader } from "@eyes/ui/header";
import sprite from "@eyes/ui/icons.svg?raw";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const APP = "https://app.eyes.pictures";
const API = "https://api.eyes.pictures";
// Section links stay in-page on the home page and point back to it elsewhere.
const home = ["/", "/index.html"].includes(Astro.url.pathname) ? "" : "/";
const header = siteHeader({
  home: "/",
  nav: `<nav class="hidden items-center gap-6 text-sm text-secondary md:flex">
    <a class="hover:text-default" href="${home}#how">How it works</a>
    <a class="hover:text-default" href="${home}#agents">For agents</a>
    <a class="hover:text-default" href="${home}#workers">For workers</a>
    <a class="hover:text-default" href="${home}#pricing">Pricing</a>
  </nav>`,
  cta: `<a class="ui-button" href="${APP}">Earn as a worker</a>`,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#212121" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://eyes.pictures/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={new URL(Astro.url.pathname.replace(/(?:index)?\.html$/, "").replace(/\/$/, "") || "/", "https://eyes.pictures").href} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname.replace(/(?:index)?\.html$/, "").replace(/\/$/, "") || "/", "https://eyes.pictures").href} />
    <meta property="og:image" content="https://eyes.pictures/images/share.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A storefront photographed for an Eyes task." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://eyes.pictures/images/share.jpg" />
    <slot name="head" />
  </head>
  <body class="ui">
    <Fragment set:html={sprite} />

    <Fragment set:html={header} />

    <slot />

    <footer class="ui-site-footer border-t border-subtle">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-5 py-8 text-sm text-secondary">
        <span class="flex items-center gap-2 font-semibold text-default"><span class="ui-mark" aria-hidden="true"></span>Eyes</span>
        <span>Built at YC's Make Something Agents Want hackathon.</span>
        <a class="ml-auto hover:text-default" href={`${API}/status`}>Status</a>
        <a class="hover:text-default" href={`${API}/llms.txt`}>llms.txt</a>
        <a class="hover:text-default" href={APP}>App</a>
        <a class="hover:text-default" href="/terms">Terms</a>
        <a class="hover:text-default" href="/privacy">Privacy</a>
      </div>
    </footer>
  </body>
</html>
