  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key from POST /v1/signup."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "description": "Every error. Extra fields carry context, for example issues for invalid_input, or balance_usd and top_up_url for insufficient_balance.",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "unauthorized",
              "invalid_input",
              "insufficient_balance",
              "bounty_exceeds_max",
              "daily_cap_exceeded",
              "task_type_not_allowed",
              "unsafe_task",
              "location_not_found",
              "no_workers_nearby",
              "task_not_found",
              "task_not_cancellable",
              "task_not_disputable",
              "idempotency_conflict",
              "offer_invalid",
              "task_already_claimed",
              "rate_limited",
              "not_implemented",
              "internal_error"
            ],
            "description": "Stable error code."
          },
          "message": {
            "type": "string",
            "description": "What went wrong."
          },
          "fix": {
            "type": "string",
            "description": "What to do next. Always present: follow it."
          }
        },
        "required": ["error", "message", "fix"],
        "additionalProperties": true
      }
    },
    "responses": {
      "Error": {
        "description": "Error. Status by code: unauthorized 401, invalid_input 400, insufficient_balance 402, bounty_exceeds_max 403, daily_cap_exceeded 403, task_type_not_allowed 403, unsafe_task 422, location_not_found 422, no_workers_nearby 409, task_not_found 404, task_not_cancellable 409, task_not_disputable 409, idempotency_conflict 409, offer_invalid 404, task_already_claimed 409, rate_limited 429, not_implemented 501, internal_error 500.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
