{
  "ask_eyes": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "bounty_usd": {
          "default": 3,
          "description": "Paid to the human who answers. A $0.50 fee is added. Both are escrowed now and refunded if nobody answers.",
          "maximum": 50,
          "minimum": 1,
          "type": "number",
        },
        "deadline_minutes": {
          "default": 30,
          "description": "Minutes until the task expires and the escrow is refunded.",
          "maximum": 240,
          "minimum": 5,
          "type": "integer",
        },
        "idempotency_key": {
          "description": "Required. Any unique string for each task you intend to create, for example a UUID. Reuse it when you retry that task: the same key and parameters return the original task and never charge twice. Use a new key for a new question.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "location": {
          "anyOf": [
            {
              "properties": {
                "lat": {
                  "description": "Latitude in decimal degrees, e.g. 37.7825",
                  "maximum": 90,
                  "minimum": -90,
                  "type": "number",
                },
                "lng": {
                  "description": "Longitude in decimal degrees, e.g. -122.4078",
                  "maximum": 180,
                  "minimum": -180,
                  "type": "number",
                },
              },
              "required": [
                "lat",
                "lng",
              ],
              "type": "object",
            },
            {
              "description": "Address or "place name, city", e.g. "Blue Bottle Coffee, Mint Plaza, San Francisco"",
              "maxLength": 200,
              "minLength": 2,
              "type": "string",
            },
          ],
          "description": "Where to look. Either numbers {"lat": 37.7825, "lng": -122.4078} or a string address / "place name, city".",
        },
        "question": {
          "description": "What the human should check, in plain words, e.g. "How many people are in line right now?"",
          "maxLength": 500,
          "minLength": 5,
          "type": "string",
        },
        "require_photo": {
          "default": true,
          "description": "Require a live photo. Keep true unless a text answer is enough; photos are what make an answer verifiable.",
          "type": "boolean",
        },
        "task_type": {
          "description": "is_open: open or closed now; line_length: how long the line is; in_stock: whether an item is on the shelf; photo_of_place: a current photo; price_check: a posted price; crowd_level: how busy it is; other_public: any other check of a public place.",
          "enum": [
            "is_open",
            "line_length",
            "in_stock",
            "photo_of_place",
            "price_check",
            "crowd_level",
            "other_public",
          ],
          "type": "string",
        },
