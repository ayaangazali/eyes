              "created_at": {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string",
              },
              "deadline_at": {
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "type": "string",
              },
              "place_label": {
                "type": "string",
              },
              "question": {
                "type": "string",
              },
              "status": {
                "enum": [
                  "dispatched",
                  "claimed",
                  "submitted",
                  "verified",
                  "paid",
                  "expired",
                  "refunded",
                  "disputed",
                  "needs_review",
                ],
                "type": "string",
              },
              "task_id": {
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string",
              },
            },
            "required": [
              "task_id",
              "status",
              "question",
              "place_label",
              "bounty_usd",
              "created_at",
              "deadline_at",
              "answered",
            ],
            "type": "object",
          },
          "maxItems": 50,
          "type": "array",
        },
      },
      "required": [
        "tasks",
        "next_step",
      ],
      "type": "object",
    },
  },
  "quote_task": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "location": {
          "anyOf": [
            {
              "properties": {
                "lat": {
                  "description": "Latitude in decimal degrees, e.g. 37.7825",
                  "maximum": 90,
                  "minimum": -90,
                  "type": "number",
                },
                "lng": {
                  "description": "Longitude in decimal degrees, e.g. -122.4078",
                  "maximum": 180,
                  "minimum": -180,
                  "type": "number",
                },
              },
              "required": [
                "lat",
                "lng",
              ],
              "type": "object",
            },
            {
              "description": "Address or "place name, city", e.g. "Blue Bottle Coffee, Mint Plaza, San Francisco"",
              "maxLength": 200,
              "minLength": 2,
              "type": "string",
            },
          ],
          "description": "Where to look. Either numbers {"lat": 37.7825, "lng": -122.4078} or a string address / "place name, city".",
        },
        "task_type": {
          "enum": [
            "is_open",
            "line_length",
            "in_stock",
            "photo_of_place",
            "price_check",
            "crowd_level",
            "other_public",
          ],
          "type": "string",
        },
      },
      "required": [
        "location",
        "task_type",
      ],
      "type": "object",
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "description": "False when this API key cannot post this task right now: Eyes' safety rules refuse this task_type at this place, the task_type is not in allowed_task_types, or even the 1 USD minimum bounty plus fee does not fit max_bounty_usd, the daily cap left or the balance. It does not check your question: ask_eyes checks the question itself and can still refuse it with unsafe_task.",
          "type": "boolean",
        },
        "est_minutes_to_answer": {
          "type": [
            "number",
            "null",
          ],
        },
        "reason_if_not": {
          "description": "Why allowed is false and what to do: change the place or task_type, top up at top_up_url, wait for the daily cap to reset at midnight UTC, or ask your user to raise a limit. Null when allowed is true.",
          "type": [
            "string",
            "null",
          ],
        },
        "resolved_location": {
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string",
            },
            "lat": {
              "type": "number",
            },
            "lng": {
              "type": "number",
            },
          },
          "required": [
            "lat",
            "lng",
            "label",
          ],
          "type": "object",
        },
        "suggested_bounty_usd": {
          "description": "A bounty ask_eyes accepts for this API key right now: the default, lowered to fit max_bounty_usd, the daily cap left after the fee, and your balance after the fee. Pass it as bounty_usd.",
          "type": "number",
        },
        "workers_nearby": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
      },
      "required": [
        "workers_nearby",
        "est_minutes_to_answer",
        "suggested_bounty_usd",
        "allowed",
        "reason_if_not",
        "resolved_location",
      ],
      "type": "object",
    },
  },
}
`;
